---
// Dried-flower branch decoration, drawn as SVG (no stock photo needed).
interface Props { class?: string; flip?: boolean; }
const { class: cls = '', flip = false } = Astro.props;
---
<svg class={cls} style={flip ? 'transform: scaleX(-1)' : ''} viewBox="0 0 120 220" fill="none" aria-hidden="true">
  <path d="M60 215 C58 150 62 90 58 20" stroke="#8a6d4b" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M59 170 C40 160 28 145 26 128 M59 170 C78 160 90 145 92 128" stroke="#8a6d4b" stroke-width="2" stroke-linecap="round"/>
  <path d="M59 120 C42 112 32 98 30 82 M59 120 C76 112 86 98 88 82" stroke="#8a6d4b" stroke-width="2" stroke-linecap="round"/>
  <path d="M58 70 C44 62 36 50 35 36 M58 70 C72 62 80 50 81 36" stroke="#8a6d4b" stroke-width="2" stroke-linecap="round"/>
  <g fill="#a98a68">
    <ellipse cx="26" cy="122" rx="7" ry="11" transform="rotate(-30 26 122)"/>
    <ellipse cx="92" cy="122" rx="7" ry="11" transform="rotate(30 92 122)"/>
    <ellipse cx="30" cy="76" rx="6" ry="10" transform="rotate(-30 30 76)"/>
    <ellipse cx="88" cy="76" rx="6" ry="10" transform="rotate(30 88 76)"/>
    <ellipse cx="35" cy="30" rx="6" ry="10" transform="rotate(-25 35 30)"/>
    <ellipse cx="81" cy="30" rx="6" ry="10" transform="rotate(25 81 30)"/>
    <ellipse cx="58" cy="14" rx="6" ry="10"/>
  </g>
</svg>
