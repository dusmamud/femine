---
// Shared contact / booking form. No backend on this static site: a valid
// submission opens the visitor's own email app with everything prefilled.
// Used by /contact and /book — keep the ids (cf-*) unique per page by
// rendering this component only once per page.
// MOCK: the mailto goes to hello@femine.in (demo address — Dus will replace
// it). ?plan= in the URL (from /pricing) preselects a plan note client-side.
import { services } from '../data/services';
---
<form id="contact-form" class="rounded-[2rem] bg-cream px-6 py-8 sm:px-8" novalidate data-reveal>
  <p id="cf-plan-note" class="mb-5 hidden rounded-2xl bg-white px-4 py-3 text-sm font-medium text-wine" role="status"></p>
  <input type="hidden" id="cf-plan" value="" />
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class="mb-2 block text-sm font-medium text-ink">Your name *</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder="Your full name" class="min-h-12 w-full rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none" />
    </div>
    <div>
      <label for="cf-email" class="mb-2 block text-sm font-medium text-ink">Email address *</label>
      <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-h-12 w-full rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none" />
    </div>
  </div>
  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-phone" class="mb-2 block text-sm font-medium text-ink">Phone <span class="font-normal text-muted">(optional)</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91 …" class="min-h-12 w-full rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none" />
    </div>
    <div class="relative" id="cf-service-wrap">
      <span id="cf-service-label" class="mb-2 block text-sm font-medium text-ink">I am interested in *</span>
      <input type="hidden" id="cf-service" name="service" value="" />
      <button type="button" id="cf-service-btn" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="cf-service-label cf-service-btn-label" class="flex min-h-12 w-full cursor-pointer items-center justify-between gap-3 rounded-2xl border border-ink/10 bg-white px-4 text-left text-[15px] text-ink transition focus:border-wine focus:outline-none">
        <span id="cf-service-btn-label" class="truncate text-muted">Choose a programme…</span>
        <svg id="cf-service-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-muted transition-transform duration-200"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <ul id="cf-service-list" role="listbox" aria-labelledby="cf-service-label" class="absolute left-0 right-0 top-full z-20 mt-2 hidden max-h-[22rem] overflow-auto rounded-2xl border border-ink/10 bg-white p-2 shadow-xl shadow-ink/10">
        {services.map((s) => (
          <li role="option" aria-selected="false" data-value={s.title} tabindex="-1" class="flex cursor-pointer items-center gap-3 rounded-xl px-3 py-3 outline-none transition hover:bg-cream focus:bg-cream">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-blush text-wine" aria-hidden="true">
              {s.icon === 'bulb' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.2 1.1 2.2h5c0-1 .4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg>}
              {s.icon === 'heart' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.3-9.3-9A5.2 5.2 0 0 1 12 6.5 5.2 5.2 0 0 1 21.3 11C19 15.7 12 20 12 20z"/><path d="M12 6.5L14 9l2.5.5"/></svg>}
              {s.icon === 'target' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>}
              {s.icon === 'chart' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18M7 16v-5M12 16V8M17 16v-3"/></svg>}
              {s.icon === 'users' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[15px] font-medium text-ink">{s.title}</span>
              <span class="block truncate text-[13px] text-muted">{s.short}</span>
            </span>
            <svg class="svc-check hidden h-5 w-5 shrink-0 text-wine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
          </li>
        ))}
        <li role="option" aria-selected="false" data-value="Not sure yet" tabindex="-1" class="flex cursor-pointer items-center gap-3 rounded-xl px-3 py-3 outline-none transition hover:bg-cream focus:bg-cream">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-blush text-wine" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 9a2.5 2.5 0 1 1 3.4 2.34c-.8.3-.9.8-.9 1.66"/><circle cx="12" cy="17.5" r="0.5" fill="currentColor"/></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-[15px] font-medium text-ink">Not sure yet</span>
            <span class="block truncate text-[13px] text-muted">Help me decide on the free call</span>
          </span>
          <svg class="svc-check hidden h-5 w-5 shrink-0 text-wine" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
        </li>
      </ul>
    </div>
  </div>
  <div class="mt-5 grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-pref-time" class="mb-2 block text-sm font-medium text-ink">Preferred time <span class="font-normal text-muted">(optional)</span></label>
      <select id="cf-pref-time" name="pref-time" class="min-h-12 w-full cursor-pointer appearance-none rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none">
        <option value="">Any time</option>
        <option value="Morning (10am – 1pm)">Morning (10am – 1pm)</option>
        <option value="Afternoon (1pm – 4pm)">Afternoon (1pm – 4pm)</option>
        <option value="Evening (4pm – 7pm)">Evening (4pm – 7pm)</option>
      </select>
    </div>
    <div>
      <label for="cf-source" class="mb-2 block text-sm font-medium text-ink">How did you hear about us? <span class="font-normal text-muted">(optional)</span></label>
      <select id="cf-source" name="source" class="min-h-12 w-full cursor-pointer appearance-none rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none">
        <option value="">Choose…</option>
        <option value="Google search">Google search</option>
        <option value="Instagram">Instagram</option>
        <option value="YouTube">YouTube</option>
        <option value="A friend">A friend</option>
        <option value="Something else">Something else</option>
      </select>
    </div>
  </div>
  <div class="mt-5">
    <label for="cf-message" class="mb-2 block text-sm font-medium text-ink">What would you like to work on? *</label>
    <textarea id="cf-message" name="message" required rows={5} placeholder="A few lines is enough — for example, “I freeze up in meetings and want to speak with more confidence.”" class="w-full resize-y rounded-2xl border border-ink/10 bg-white px-4 py-3 text-[15px] focus:border-wine focus:outline-none"></textarea>
  </div>
  <p id="cf-error" class="mt-4 hidden text-sm font-medium text-rose-deep" role="alert"></p>
  <p id="cf-success" class="mt-4 hidden rounded-2xl bg-white px-4 py-3 text-sm font-medium text-wine" role="status"></p>
  <button type="submit" class="mt-6 inline-flex min-h-12 cursor-pointer items-center rounded-full bg-rose px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Send my message →</button>
  <p class="mt-3 text-[13px] text-muted">Your message opens in your own email app — nothing is stored on this website.</p>
</form>

<script>
  // Custom programme picker — a styled listbox (button + options with icons),
  // replacing the native <select>. The chosen value lives in the hidden
  // #cf-service input, so the submit handler below reads it unchanged.
  const svcBtn = document.getElementById('cf-service-btn') as HTMLButtonElement | null;
  const svcList = document.getElementById('cf-service-list') as HTMLUListElement | null;
  const svcInput = document.getElementById('cf-service') as HTMLInputElement | null;
  const svcLabel = document.getElementById('cf-service-btn-label') as HTMLSpanElement | null;
  const svcChevron = document.getElementById('cf-service-chevron') as SVGSVGElement | null;
  const svcOptions = svcList ? [...svcList.querySelectorAll<HTMLElement>('[role="option"]')] : [];
  let svcOpen = false;

  function setSvcOpen(open: boolean) {
    svcOpen = open;
    svcList?.classList.toggle('hidden', !open);
    svcBtn?.setAttribute('aria-expanded', String(open));
    svcBtn?.classList.toggle('border-wine', open);
    if (svcChevron) svcChevron.style.transform = open ? 'rotate(180deg)' : '';
  }
  function selectSvc(opt: HTMLElement, focusBtn = true) {
    svcOptions.forEach((o) => {
      const on = o === opt;
      o.setAttribute('aria-selected', String(on));
      o.classList.toggle('bg-cream', on);
      o.querySelector('.svc-check')?.classList.toggle('hidden', !on);
    });
    if (svcInput) svcInput.value = opt.dataset.value ?? '';
    if (svcLabel) {
      svcLabel.textContent = opt.dataset.value === 'Not sure yet' ? 'Not sure yet — help me decide' : (opt.dataset.value ?? '');
      svcLabel.classList.remove('text-muted');
    }
    svcBtn?.classList.remove('border-rose-deep');
    setSvcOpen(false);
    if (focusBtn) svcBtn?.focus();
  }
  svcBtn?.addEventListener('click', () => setSvcOpen(!svcOpen));
  svcOptions.forEach((opt) => opt.addEventListener('click', () => selectSvc(opt)));
  document.addEventListener('click', (e) => {
    if (svcOpen && svcBtn && svcList && !svcBtn.contains(e.target as Node) && !svcList.contains(e.target as Node)) setSvcOpen(false);
  });
  svcBtn?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      if (!svcOpen) { setSvcOpen(true); svcOptions[0]?.focus(); }
    } else if (e.key === 'Escape' && svcOpen) {
      e.preventDefault(); setSvcOpen(false); svcBtn.focus();
    }
  });
  svcList?.addEventListener('keydown', (e) => {
    const i = svcOptions.indexOf(document.activeElement as HTMLElement);
    if (e.key === 'ArrowDown') { e.preventDefault(); svcOptions[Math.min(i + 1, svcOptions.length - 1)]?.focus(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); if (i <= 0) svcBtn?.focus(); else svcOptions[i - 1]?.focus(); }
    else if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); if (i >= 0) selectSvc(svcOptions[i]); }
    else if (e.key === 'Escape') { e.preventDefault(); setSvcOpen(false); svcBtn?.focus(); }
    else if (e.key === 'Tab') setSvcOpen(false);
  });

  // Plan preselect from ?plan= (linked from /pricing and gift cards).
  // Runs client-side: the site is static, so the query string only exists
  // in the browser. Unknown values are ignored.
  const planNames: Record<string, string> = {
    single: 'Single Session',
    growth: 'Growth Pack',
    transform: 'Transform Pack',
    'gift-1999': 'Gift Card · ₹1,999',
    'gift-3999': 'Gift Card · ₹3,999',
    'gift-6999': 'Gift Card · ₹6,999',
  };
  const planInput = document.getElementById('cf-plan') as HTMLInputElement | null;
  const planNote = document.getElementById('cf-plan-note');
  const planQ = new URLSearchParams(location.search).get('plan');
  if (planQ && planNames[planQ]) {
    if (planInput) planInput.value = planNames[planQ];
    if (planNote) {
      planNote.textContent = `You picked the ${planNames[planQ]} — we will confirm it on your free call.`;
      planNote.classList.remove('hidden');
    }
  }

  // Contact form — no backend on this static site, so a valid submission
  // opens the visitor's own email app with everything prefilled.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const err = document.getElementById('cf-error');
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)?.value.trim() ?? '';
    const name = get('cf-name'), email = get('cf-email'), phone = get('cf-phone'), service = get('cf-service'), message = get('cf-message');
    const plan = get('cf-plan'), prefTime = get('cf-pref-time'), source = get('cf-source');
    const date = get('cf-date'), time = get('cf-time');
    const showErr = (text: string, focusId: string) => {
      if (!err) return;
      err.textContent = text;
      err.classList.remove('hidden');
      if (focusId === 'cf-service') {
        // Hidden input can't take focus — focus the picker button instead.
        svcBtn?.focus();
        svcBtn?.classList.add('border-rose-deep');
      } else {
        (document.getElementById(focusId) as HTMLElement)?.focus();
      }
    };
    if (!name) return showErr('Please enter your name.', 'cf-name');
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return showErr('Please enter a valid email address.', 'cf-email');
    if (!service) return showErr('Please choose a programme — or “Not sure yet”.', 'cf-service');
    if (!message) return showErr('Please tell us a little about what you would like to work on.', 'cf-message');
    err?.classList.add('hidden');
    const subject = encodeURIComponent(`Femine enquiry — ${service} (${name})`);
    const body = encodeURIComponent(`Name: ${name}\nEmail: ${email}\nPhone: ${phone || '—'}\nProgramme: ${service}\nPlan: ${plan || '—'}\nPreferred day: ${date || '—'}\nPreferred time slot: ${time || '—'}\nPreferred time of day: ${prefTime || '—'}\nHeard about us: ${source || '—'}\n\n${message}`);
    // Show the confirmation first, then open the mail app — setting
    // location.href first can interrupt the DOM update.
    const ok = document.getElementById('cf-success');
    if (ok) {
      ok.textContent = 'Thank you, ' + name.split(' ')[0] + ' — your email app should have opened with the message ready. Just press send, and we will reply within 24 hours.';
      ok.classList.remove('hidden');
    }
    setTimeout(() => {
      // MOCK email — keep in sync with src/data/site.ts. (Was define:vars,
      // but define:vars scripts are not type-stripped, so the `as` casts
      // in this script threw a SyntaxError and killed the whole form.)
      window.location.href = `mailto:hello@femine.in?subject=${subject}&body=${body}`;
    }, 300);
  });
</script>
