---
import { services } from '../data/services';
import { socials } from '../data/socials';
---
<footer class="bg-wine pb-10 pt-12 text-white/85">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 pb-10 lg:grid-cols-4">
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex w-fit items-center gap-1.5">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z" fill="#e78f8f"/></svg>
          <span class="font-display text-2xl font-bold italic text-white">Femine</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">Personal coaching for confidence, relationships and career growth — practical sessions, real change.</p>
        <p class="mt-4 text-sm text-white/70">Online sessions · Mon–Sat, 10am–7pm</p>
        <a href="/contact" class="mt-2 inline-block text-sm font-medium text-white underline decoration-rose decoration-2 underline-offset-4 hover:text-rose">Book your free session →</a>
        <div class="mt-6">
          <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-white/50">Follow us</p>
          <ul class="mt-3 flex flex-wrap gap-2.5 lg:gap-2">
            {socials.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-white/20 bg-white/10 text-white transition hover:border-rose hover:bg-rose focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:h-10 lg:w-10">
                  {s.icon === 'instagram' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>}
                  {s.icon === 'facebook' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>}
                  {s.icon === 'youtube' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>}
                  {s.icon === 'linkedin' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>}
                  {s.icon === 'x' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <nav aria-label="Explore">
        <h3 class="font-display text-base font-semibold text-white">Explore</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/" class="inline-block min-h-6 py-0.5 hover:text-white">Home</a></li>
          <li><a href="/about" class="inline-block min-h-6 py-0.5 hover:text-white">About Us</a></li>
          <li><a href="/services" class="inline-block min-h-6 py-0.5 hover:text-white">Services</a></li>
          <li><a href="/testimonials" class="inline-block min-h-6 py-0.5 hover:text-white">Testimonials</a></li>
          <li><a href="/blog" class="inline-block min-h-6 py-0.5 hover:text-white">Blog</a></li>
          <li><a href="/faq" class="inline-block min-h-6 py-0.5 hover:text-white">FAQ</a></li>
          <li><a href="/sitemap" class="inline-block min-h-6 py-0.5 hover:text-white">Sitemap</a></li>
          <li><a href="/contact" class="inline-block min-h-6 py-0.5 hover:text-white">Contact Us</a></li>
        </ul>
      </nav>
      <nav aria-label="Services">
        <h3 class="font-display text-base font-semibold text-white">Services</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a href={`/services/${s.slug}`} class="inline-block min-h-6 py-0.5 hover:text-white">{s.title}</a></li>
          ))}
        </ul>
      </nav>
      <div class="col-span-2 lg:col-span-1">
        <h3 class="font-display text-base font-semibold text-white">Get one gentle tip every week</h3>
        <form id="newsletter-form" class="mt-4 flex flex-col gap-3" novalidate>
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-h-12 w-full rounded-full border border-white/25 bg-white/10 px-5 text-[15px] text-white placeholder:text-white/50 focus:border-white focus:outline-none" />
          <button type="submit" class="min-h-12 cursor-pointer rounded-full bg-rose px-6 text-[15px] font-medium text-white transition hover:bg-rose-deep">Subscribe</button>
        </form>
        <p id="newsletter-msg" class="mt-3 text-sm text-white/60" role="status" aria-live="polite">No spam, unsubscribe anytime.</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-3 border-t border-white/15 pt-6 text-center sm:flex-row sm:text-left">
      <p class="text-[13px] text-white/60">© 2026 Femine. All rights reserved.</p>
      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[13px]" aria-label="Legal">
        <a href="/privacy-policy" class="hover:text-white">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-white">Terms &amp; Conditions</a>
        <a href="/cookie-policy" class="hover:text-white">Cookie Policy</a>
        <a href="/sitemap-index.xml" class="hover:text-white">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>
