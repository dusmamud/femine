---
import { services } from '../data/services';
---
<footer class="bg-wine pb-10 pt-12 text-white/85">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-10 pb-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-1.5">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z" fill="#e78f8f"/></svg>
          <span class="font-display text-2xl font-bold italic text-white">Femine</span>
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/70">Personal coaching for confidence, relationships and career growth — practical sessions, real change.</p>
        <p class="mt-4 text-sm text-white/70">Online sessions · Mon–Sat, 10am–7pm<br />First session free</p>
      </div>
      <nav aria-label="Explore">
        <h3 class="font-display text-base font-semibold text-white">Explore</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/" class="hover:text-white">Home</a></li>
          <li><a href="/about" class="hover:text-white">About Us</a></li>
          <li><a href="/services" class="hover:text-white">Services</a></li>
          <li><a href="/contact" class="hover:text-white">Contact Us</a></li>
        </ul>
      </nav>
      <nav aria-label="Services">
        <h3 class="font-display text-base font-semibold text-white">Services</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a href={`/services/${s.slug}`} class="hover:text-white">{s.title}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <h3 class="font-display text-base font-semibold text-white">Get one gentle tip every week</h3>
        <form id="newsletter-form" class="mt-4 flex flex-col gap-3" novalidate>
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-h-12 w-full rounded-full border border-white/25 bg-white/10 px-5 text-[15px] text-white placeholder:text-white/50 focus:border-white focus:outline-none" />
          <button type="submit" class="min-h-12 cursor-pointer rounded-full bg-rose px-6 text-[15px] font-medium text-white transition hover:bg-rose-deep">Subscribe</button>
        </form>
        <p id="newsletter-msg" class="mt-3 text-sm text-white/60" role="status" aria-live="polite">No spam, unsubscribe anytime.</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-4 border-t border-white/15 pt-6 sm:flex-row">
      <p class="text-[13px] text-white/60">© 2026 Femine. All rights reserved.</p>
      <nav class="flex gap-6 text-[13px]" aria-label="Legal">
        <a href="/privacy-policy" class="hover:text-white">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-white">Terms &amp; Conditions</a>
      </nav>
    </div>
  </div>
</footer>
