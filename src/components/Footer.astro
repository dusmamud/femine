---
import { services } from '../data/services';
import { socials } from '../data/socials';
import { contact } from '../data/site';
import PaymentIcons from './PaymentIcons.astro';
---
<footer class="bg-wine pb-10 pt-14 text-white/85">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <!-- ZONE 1: brand + newsletter card -->
    <div class="grid gap-10 border-b border-white/10 pb-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <a href="/" class="flex w-fit items-center gap-3" aria-label="Femine home">
          <svg width="40" height="40" viewBox="0 0 120 120" fill="none" aria-hidden="true"><path d="M20 108V62C20 34 38 16 60 16s40 18 40 46v46H20Z" fill="#fbe9e4"/><path d="M60 28l5.4 18.6L84 52l-18.6 5.4L60 76l-5.4-18.6L36 52l18.6-5.4Z" fill="#e78f8f"/><path d="M86 74l2.6 9.4L98 86l-9.4 2.6L86 98l-2.6-9.4L74 86l9.4-2.6Z" fill="#ffffff"/></svg>
          <span>
            <span class="block font-display text-[28px] font-bold italic leading-none text-white">Femine</span>
            <span class="mt-1.5 block text-[10px] font-medium uppercase tracking-[0.22em] text-white/60">Personality Coaching</span>
          </span>
        </a>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-white/70">Personal coaching for confidence, relationships and career growth — practical sessions, real change.</p>
        <div class="mt-7">
          <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-white/50">Follow us</p>
          <ul class="mt-3 flex flex-wrap gap-2.5">
            {socials.map((s) => (
              <li>
                <a href={s.href} aria-label={s.label} class="grid h-11 w-11 place-items-center rounded-full border border-white/20 bg-white/10 text-white transition hover:border-rose hover:bg-rose focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                  {s.icon === 'instagram' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>}
                  {s.icon === 'facebook' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>}
                  {s.icon === 'youtube' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>}
                  {s.icon === 'linkedin' && <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>}
                  {s.icon === 'x' && <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="rounded-[2rem] border border-white/10 bg-white/5 p-6 sm:p-8">
        <h3 class="font-display text-xl font-semibold text-white">Get one gentle tip every week</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/70">One short, practical tip in your inbox every Monday — something to practise, not just read.</p>
        <form id="newsletter-form" class="mt-5 flex flex-col gap-3 sm:flex-row" novalidate>
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input id="newsletter-email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-h-12 w-full flex-1 rounded-full border border-white/25 bg-white/10 px-5 text-[15px] text-white placeholder:text-white/50 focus:border-white focus:outline-none" />
          <button type="submit" class="min-h-12 shrink-0 cursor-pointer rounded-full bg-rose px-7 text-[15px] font-medium text-white transition hover:bg-rose-deep">Subscribe</button>
        </form>
        <p id="newsletter-msg" class="mt-3 text-sm text-white/60" role="status" aria-live="polite">No spam, unsubscribe anytime.</p>
      </div>
    </div>

    <!-- ZONE 2: link columns + contact -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 py-12 lg:grid-cols-4">
      <nav aria-label="Explore">
        <h3 class="font-display text-base font-semibold text-white">Explore</h3>
        <span class="mt-2.5 block h-0.5 w-7 rounded bg-rose/70" aria-hidden="true"></span>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Home</a></li>
          <li><a href="/about" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">About Us</a></li>
          <li><a href="/services" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Services</a></li>
          <li><a href="/pricing" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Pricing</a></li>
          <li><a href="/book" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Book a Free Session</a></li>
          <li><a href="/testimonials" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Testimonials</a></li>
        </ul>
      </nav>
      <nav aria-label="Services">
        <h3 class="font-display text-base font-semibold text-white">Services</h3>
        <span class="mt-2.5 block h-0.5 w-7 rounded bg-rose/70" aria-hidden="true"></span>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a href={`/services/${s.slug}`} class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">{s.title}</a></li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Resources">
        <h3 class="font-display text-base font-semibold text-white">Resources</h3>
        <span class="mt-2.5 block h-0.5 w-7 rounded bg-rose/70" aria-hidden="true"></span>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href="/quiz" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Confidence Quiz</a></li>
          <li><a href="/start-here" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Start Here</a></li>
          <li><a href="/method" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Our Method</a></li>
          <li><a href="/resources" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Resources</a></li>
          <li><a href="/events" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Events &amp; Workshops</a></li>
          <li><a href="/challenges" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">7-Day Challenge</a></li>
          <li><a href="/results" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Results</a></li>
          <li><a href="/free-guide" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Free Guide</a></li>
          <li><a href="/blog" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Blog</a></li>
          <li><a href="/faq" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">FAQ</a></li>
          <li><a href="/sitemap" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Sitemap</a></li>
          <li><a href="/contact" class="inline-block min-h-6 py-0.5 hover:text-white hover:underline hover:underline-offset-4">Contact Us</a></li>
        </ul>
      </nav>
      <address class="not-italic">
        <h3 class="font-display text-base font-semibold text-white">Talk to us</h3>
        <span class="mt-2.5 block h-0.5 w-7 rounded bg-rose/70" aria-hidden="true"></span>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
            <a href={`mailto:${contact.email}`} class="break-all hover:text-white hover:underline hover:underline-offset-4">{contact.email}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href={contact.phoneHref} class="hover:text-white hover:underline hover:underline-offset-4">{contact.phoneDisplay}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.5L3 21l2-5.6A8.5 8.5 0 1 1 21 11.5z"/></svg>
            <a href={contact.whatsapp} target="_blank" rel="noopener" class="hover:text-white hover:underline hover:underline-offset-4">WhatsApp us</a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <span>Online sessions · {contact.hours}</span>
          </li>
        </ul>
        <a href="/book" class="mt-5 inline-block text-sm font-medium text-white underline decoration-rose decoration-2 underline-offset-4 hover:text-rose">Book your free session →</a>
      </address>
    </div>

    <!-- ZONE 3: payments -->
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-white/10 py-7">
      <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-white/50">We accept</p>
      <PaymentIcons size="sm" />
    </div>

    <!-- ZONE 4: bottom bar -->
    <div class="flex flex-col items-center justify-between gap-3 border-t border-white/10 pt-6 text-center sm:flex-row sm:text-left">
      <p class="text-[13px] text-white/60">© 2026 Femine. All rights reserved.</p>
      <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[13px]" aria-label="Legal">
        <a href="/privacy-policy" class="hover:text-white hover:underline hover:underline-offset-4">Privacy Policy</a>
        <a href="/terms-and-conditions" class="hover:text-white hover:underline hover:underline-offset-4">Terms &amp; Conditions</a>
        <a href="/cookie-policy" class="hover:text-white hover:underline hover:underline-offset-4">Cookie Policy</a>
        <a href="/refund-policy" class="hover:text-white hover:underline hover:underline-offset-4">Refund Policy</a>
        <a href="/accessibility" class="hover:text-white hover:underline hover:underline-offset-4">Accessibility</a>
        <a href="/sitemap-index.xml" class="hover:text-white hover:underline hover:underline-offset-4">Sitemap</a>
      </nav>
    </div>
  </div>
</footer>
