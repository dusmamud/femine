---
// Payment method brand marks — self-hosted inline SVG, no external requests.
// Visa: thesvg.org (Simple Icons rendition, cropped to the wordmark).
// Mastercard: thesvg.org path redrawn as the two-circle mark in official colours.
// UPI: thesvg.org (official logo, cropped to the mark; tagline removed).
// RuPay: official wordmark (frame + TM badge removed).
// NetBanking has no brand mark, so it uses a generic bank glyph + label.
// Brand logos are shown only to indicate which payment methods are accepted.
interface Props {
  size?: 'md' | 'sm';
}
const { size = 'md' } = Astro.props;
const chip =
  size === 'sm'
    ? 'inline-flex items-center rounded-full border border-ink/10 bg-white px-2.5 py-1.5 shadow-sm'
    : 'inline-flex items-center rounded-full border border-ink/10 bg-white px-3 py-2 shadow-sm';
const h = size === 'sm' ? 'h-4' : 'h-5';
const hVisa = size === 'sm' ? 'h-3' : 'h-3.5';
const label = size === 'sm' ? 'text-xs font-semibold text-ink' : 'text-[13px] font-semibold text-ink';
---
<ul class="flex flex-wrap items-center gap-2" aria-label="Accepted payment methods">
  <li class={chip} title="UPI">
    <svg class={`${h} w-auto`} viewBox="27 39 388 105" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="UPI"><path d="M316.46,139.51h-19.28l26.82-96.86h19.28l-26.82,96.86Z" fill="#6e6f71"/><path d="M306.45,45.71c-1.34-1.84-3.4-2.77-6.2-2.77h-106.04l-5.25,18.97h19.29s77.17-.01,77.17-.01l-5.61,20.27h-77.17v-.04s-19.28,0-19.28,0l-16.01,57.79h19.3l10.74-38.79h86.75c2.71,0,5.26-.92,7.66-2.77,2.39-1.85,3.97-4.13,4.72-6.86l10.74-38.79c.78-2.82.51-5.15-.81-7Z" fill="#6e6f71"/><path d="M156.12,133.46c-1.07,3.83-4.56,6.49-8.54,6.49H48.09c-2.71,0-4.73-.92-6.05-2.77-1.32-1.85-1.61-4.13-.85-6.86l24.28-87.39h19.3l-21.68,78.05h77.21l21.68-78.05h19.3l-25.15,90.53Z" fill="#6e6f71"/><polygon points="376.59 42.83 401 91.38 349.68 139.92 376.59 42.83" fill="#0f8041"/><polygon points="359.47 42.83 383.87 91.38 332.52 139.92 359.47 42.83" fill="#e97726"/></svg>
  </li>
  <li class={chip} title="Visa">
    <svg class={`${hVisa} w-auto`} viewBox="-1 7.8 26 8.4" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Visa"><path d="M9.112 8.262L5.97 15.758H3.92L2.374 9.775c-.094-.368-.175-.503-.461-.658C1.447 8.864.677 8.627 0 8.479l.046-.217h3.3a.904.904 0 01.894.764l.817 4.338 2.018-5.102zm8.033 5.049c.008-1.979-2.736-2.088-2.717-2.972.006-.269.262-.555.822-.628a3.66 3.66 0 011.913.336l.34-1.59a5.207 5.207 0 00-1.814-.333c-1.917 0-3.266 1.02-3.278 2.479-.012 1.079.963 1.68 1.698 2.04.756.367 1.01.603 1.006.931-.005.504-.602.725-1.16.734-.975.015-1.54-.263-1.992-.473l-.351 1.642c.453.208 1.289.39 2.156.398 2.037 0 3.37-1.006 3.377-2.564m5.061 2.447H24l-1.565-7.496h-1.656a.883.883 0 00-.826.55l-2.909 6.946h2.036l.405-1.12h2.488zm-2.163-2.656l1.02-2.815.588 2.815zm-8.16-4.84l-1.603 7.496H8.34l1.605-7.496z" fill="#1A1F71"/></svg>
  </li>
  <li class={chip} title="Mastercard">
    <svg class={`${h} w-auto`} viewBox="0 0 36 24" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Mastercard"><circle cx="13" cy="12" r="10" fill="#EB001B"/><circle cx="23" cy="12" r="10" fill="#F79E1B"/><path d="M18 4 A10 10 0 0 1 18 20 A10 10 0 1 0 18 4 Z" fill="#FF5F00"/></svg>
  </li>
  <li class={chip} title="RuPay">
    <svg class={`${h} w-auto`} viewBox="31609.68 68270.6 259019.64 67537.8" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="RuPay"><path d="M214088 83928h13199v20970l11418-20970h12113l-24422 42395s-2267 3556-5079 5437c-2310 1547-5151 1477-6019 1540-4824-42-10643-55-10643-55l2807-10106 4542-8s2079-212 2882-1237c765-977 1156-1954 1156-3387 0-2148-1954-34580-1954-34580zM76939 88116c-1837 4256-7533 3772-7533 3772l-6632-31 2421-9013s5933 22 8843 22c3115 0 4088 2502 2902 5249zm15073-6142c1129-8943-6741-11201-15250-11201H54402l-13199 48105h14208l4436-16333 7970 65s3289-191 3354 2898c69 3295-2442 9345-2280 13370h14596l-32-1281s-1213-322-1078-2026c56-709 839-2953 1864-5979 618-1334 1550-4499 1464-7076-107-3217-2126-4710-5037-5754 9074-2128 11342-14787 11343-14787zm3224 1954h12959l-5337 20533s-1331 4579 2952 4932c3384 280 5902-3758 6727-6493 1084-3592 5296-18973 5296-18973h13351l-10159 34950h-11657l1432-4993s-5947 7252-14783 6382c-7854-771-8531-6468-7170-13575 668-3489 6389-22763 6389-22763zm66557 4298c-1849 5158-6944 4550-6944 4550l-6956 2 2746-10220s4403 23 7311 23c3560 0 4852 2828 3843 5644zm14609-4776c1130-8944-5687-12678-14197-12678h-22359l-13198 48105h14208l3995-14831 11320 69s17530 742 20232-20665zm11945 28307c-2220 563-4912 869-5446-1148-1466-5527 11474-7145 11474-7145 88 5036-4325 7859-6029 8293zm19575-10116c1707-5814 3865-11319 2128-14370-2660-4670-7468-5080-14502-5080-7771 0-17365 1476-20492 11810h12937s1179-3892 6035-3647c4298 217 4063 3174 2479 4809-2778 2865-10450 1276-18947 4224-7424 2576-10022 12338-8409 16234 1563 3778 4474 4259 8401 4645 6307 620 11143-2897 13394-4961 0 2292 60 3572 60 3572h13614l-33-1281s-1213-322-1078-2026c98-1248 2450-7252 4412-13929z" fill="#382a8d"/><path fill="#1d8546" d="M267751 75852l-15239 53011 28524-26506z"/><path fill="#ec6b00" d="M257982 75852l-15239 53011 28525-26506z"/></svg>
  </li>
  <li class={chip}>
    <span class="inline-flex items-center gap-1.5">
      <svg class={`${h} w-auto`} viewBox="0 0 24 24" fill="none" stroke="#6e2434" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9.5 12 3l9 6.5"/><path d="M4.5 10v9M19.5 10v9M8.5 12.5v6.5M12 12.5v6.5M15.5 12.5v6.5M2.5 21.5h19"/></svg>
      <span class={label}>NetBanking</span>
    </span>
  </li>
</ul>
