---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Page not found — Femine" description="This page does not exist. Head back to the Femine home page.">
  <Header />
  <main id="main">
    <section class="curve-bottom overflow-hidden bg-cream pb-20 pt-36 text-center sm:pb-24 lg:pt-40">
      <div class="mx-auto max-w-2xl px-5">
        <p class="font-display text-7xl font-bold text-rose/50" aria-hidden="true">404</p>
        <h1 class="fluid-h1 mt-4 font-display font-semibold text-ink">This page took a wrong turn</h1>
        <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-muted">The page you are looking for does not exist, or it may have moved. Let us get you back on track.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href="/" class="inline-flex min-h-12 items-center rounded-full bg-rose px-7 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Back to home</a>
          <a href="/services" class="inline-flex min-h-12 items-center rounded-full border-2 border-wine px-7 text-[15px] font-medium text-wine transition hover:bg-wine hover:text-white">Browse services</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
