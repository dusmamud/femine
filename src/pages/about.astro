---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import welcomeImg from '../assets/welcome.jpg';
import coachImg from '../assets/about-coach.jpg';
import heroImg from '../assets/hero.jpg';
import { coach } from '../data/site';

const values = [
  { title: 'Practical, never preachy', text: 'Every session ends with one small thing you can actually do this week — not a lecture you forget by dinner.' },
  { title: 'Honest feedback', text: 'We tell you what you need to hear, kindly. Growth does not happen inside a comfort zone.' },
  { title: 'Your pace, your goals', text: 'There is no fixed mould. Your plan is built around your life, your work and your values.' },
  { title: 'Privacy, always', text: 'What you share in a session stays in the session. No exceptions, no small print.' },
];

const timeline = [
  { year: '2012', text: 'Femine begins with one-to-one coaching sessions in a small studio.' },
  { year: '2016', text: 'Our 100th client completes a programme — and refers her sister.' },
  { year: '2020', text: 'Sessions move online, reaching women across India and beyond.' },
  { year: '2026', text: '500+ women coached, 28 certifications, and still one conversation at a time.' },
];
const personLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: coach.name,
      jobTitle: coach.role,
      description: coach.intro,
      knowsAbout: ['Confidence coaching', 'Communication skills', 'Career growth', 'Relationships', 'Decision making'],
      alumniOf: { '@type': 'EducationalOrganization', name: 'University of Delhi' },
      hasCredential: [
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'ICF Professional Certified Coach (PCC)' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'degree', name: 'MA Psychology, University of Delhi' },
        { '@type': 'EducationalOccupationalCredential', credentialCategory: 'certification', name: 'Certified in CBT-based coaching & NLP' },
      ],
      worksFor: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' },
    },
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/about/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
    {
      '@type': 'VideoObject',
      name: 'A quick hello from Meera — your coach',
      description: 'Meet Meera Kapoor, founder and lead coach at Femine, in a short introduction video.',
      thumbnailUrl: 'https://femine.pages.dev/og-about.png',
      contentUrl: 'https://femine.pages.dev/videos/coach-intro.mp4',
      uploadDate: '2026-11-15',
      duration: 'PT6S',
    },
  ],
};
---
<Layout title="About Us — Femine" description={`Meet ${coach.name}, Femine's founder and lead coach — ICF-certified, 14 years, 500+ women coached. Coaching that respects who you already are.`} jsonLd={personLd} ogImage="https://femine.pages.dev/og-about.png">
  <Header />
  <main id="main">
    <PageHero eyebrow="About Us" title="Coaching that respects who you already are" text="We do not fix people. We help them see what is already strong in them — and build the skills to show it." crumb="About Us" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 sm:gap-12 lg:grid-cols-2 lg:gap-16 lg:px-8">
        <div class="relative mx-auto w-full max-w-[340px] pb-10 pr-6 sm:max-w-[420px] sm:pb-12" data-reveal>
          <div class="arch relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
            <Picture src={welcomeImg} alt="Woman looking up with confidence" widths={[360, 720]} sizes="(max-width: 640px) 340px, 420px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="eager" fetchpriority="high" class="aspect-[4/5] w-full object-cover object-top" />
          </div>
          <figure class="absolute bottom-0 right-0 w-40 rounded-3xl border-4 border-white bg-white shadow-xl sm:w-48">
            <Picture src={coachImg} alt="Two women in a warm coaching conversation" widths={[200, 400]} sizes="200px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="lazy" class="aspect-[4/3] w-full rounded-[1.25rem] object-cover" />
            <figcaption class="px-3 py-2.5 text-center text-[12px] font-medium leading-tight text-ink">Your coach,<br /><span class="text-muted">in every session</span></figcaption>
          </figure>
        </div>
        <div data-reveal>
          <h2 class="fluid-h2 font-display font-semibold text-ink">Our story</h2>
          <p class="mt-5 text-base leading-relaxed text-muted">
            Femine started in 2012, when our founder kept meeting the same woman in
            different rooms: brilliant at her work, quiet in the meeting, and doubting
            herself on the way home. The problem was never ability — it was the
            belief that confidence belongs to other people.
          </p>
          <p class="mt-4 text-base leading-relaxed text-muted">
            Fourteen years later, the method is the same: listen first, judge never,
            and practise the hard moments in a safe room before you face them in
            real life. That is how 500+ women found their voice — and kept it.
          </p>
          <dl class="mt-8 grid grid-cols-3 gap-3 text-center sm:gap-4">
            <div class="rounded-2xl bg-cream px-2 py-4"><dd class="font-display text-[28px] font-semibold text-ink">14</dd><dt class="mt-1 text-[13px] text-muted">Years coaching</dt></div>
            <div class="rounded-2xl bg-cream px-2 py-4"><dd class="font-display text-[28px] font-semibold text-ink">500+</dd><dt class="mt-1 text-[13px] text-muted">Women coached</dt></div>
            <div class="rounded-2xl bg-cream px-2 py-4"><dd class="font-display text-[28px] font-semibold text-ink">4.9</dd><dt class="mt-1 text-[13px] text-muted">Average rating</dt></div>
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ MEET YOUR COACH ============ -->
    <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="Meet your coach">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 sm:gap-12 lg:grid-cols-2 lg:gap-16 lg:px-8">
        <div data-reveal>
          <div class="arch relative mx-auto w-full max-w-[340px] overflow-hidden bg-blush shadow-xl shadow-rose/20 sm:max-w-[420px]">
            <Picture src={heroImg} alt={`${coach.name}, founder and lead coach at Femine`} widths={[360, 720]} sizes="(max-width: 640px) 340px, 420px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="lazy" class="aspect-[3/4] w-full object-cover object-top" />
          </div>
          <p class="mt-6 text-center text-sm text-muted"><strong class="font-semibold text-ink">{coach.name}</strong> · {coach.role}</p>
          <figure class="mx-auto mt-8 max-w-[420px]">
            <video controls preload="metadata" poster={heroImg.src} class="aspect-video w-full rounded-[2rem] object-cover shadow-lg shadow-rose/10">
              <source src="/videos/coach-intro.mp4" type="video/mp4" />
            </video>
            <figcaption class="mt-3 text-center text-[13px] text-muted">A quick hello from {coach.name.split(' ')[0]} — your coach</figcaption>
          </figure>
        </div>
        <div data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Meet Your Coach</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Hi, I&rsquo;m {coach.name.split(' ')[0]}.</h2>
          <p class="mt-5 text-base leading-relaxed text-muted">{coach.intro}</p>
          <ul class="mt-7 space-y-3">
            {coach.credentials.map((c) => (
              <li class="flex gap-3 text-[15px] leading-relaxed text-ink">
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-rose text-[13px] font-bold text-white" aria-hidden="true">✓</span>{c}
              </li>
            ))}
          </ul>
          <blockquote class="mt-8 rounded-[2rem] border-l-4 border-rose bg-white px-6 py-5 font-display text-[19px] italic leading-snug text-ink">
            &ldquo;{coach.philosophy}&rdquo;
          </blockquote>
          <a href="/book" class="mt-8 inline-flex min-h-12 items-center rounded-full bg-rose px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Book a free call with {coach.name.split(' ')[0]} →</a>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20 lg:py-24" aria-label="What happens in a session">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="max-w-3xl" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Inside a Session</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">What happens in a session?</h2>
          <p class="lead-answer mt-5 text-lg font-medium leading-relaxed text-ink">Femine is an online personality coaching service founded in 2012 by Meera Kapoor, an ICF-certified coach with 14 years of experience. Sessions are 1-to-1 over video call, 60 minutes, Monday to Saturday — practical coaching built around your real situations, not lectures or personality tests.</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="font-display text-2xl font-bold text-rose-deep">01</p>
            <h3 class="mt-3 font-display text-xl font-semibold text-ink">You talk first</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">The first ten minutes are yours. What happened this week, what is stuck, what you want to change. No forms, no intake quiz — just a conversation.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="font-display text-2xl font-bold text-rose-deep">02</p>
            <h3 class="mt-3 font-display text-xl font-semibold text-ink">We find the pattern</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Most problems repeat themselves in different clothes. Together we spot the pattern — the sentence you always swallow, the decision you always postpone — and name it plainly.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="font-display text-2xl font-bold text-rose-deep">03</p>
            <h3 class="mt-3 font-display text-xl font-semibold text-ink">You practise it live</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">We rehearse the hard moment right there in the session — the meeting, the conversation, the ask. Awkward in the room, easy in real life. That is the whole point of practice.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="font-display text-2xl font-bold text-rose-deep">04</p>
            <h3 class="mt-3 font-display text-xl font-semibold text-ink">One thing to do this week</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Every session ends with a single, specific action — small enough to actually do, brave enough to matter. Next week we review what happened and build on it.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="Who Femine is for">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="text-center" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Is This For You?</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Who Femine is for — and who it isn&rsquo;t</h2>
        </div>
        <div class="mt-12 grid gap-6 lg:grid-cols-2" data-reveal-group>
          <div class="rounded-[2rem] bg-white px-7 py-8 shadow-sm">
            <h3 class="font-display text-xl font-semibold text-ink">Femine is for you if&hellip;</h3>
            <ul class="mt-5 space-y-3 text-[15px] leading-relaxed text-muted">
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You are good at your work but quiet in the rooms where it counts.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You say yes when you mean no, then resent it all week.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You have outgrown your current role but cannot name what comes next.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You want practical tools, not motivational speeches.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You are willing to practise — one small brave thing a week.</li>
            </ul>
          </div>
          <div class="rounded-[2rem] bg-white px-7 py-8 shadow-sm">
            <h3 class="font-display text-xl font-semibold text-ink">Femine is probably not for you if&hellip;</h3>
            <ul class="mt-5 space-y-3 text-[15px] leading-relaxed text-muted">
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You want a quick fix with no practice in between sessions.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You are looking for therapy or clinical help — that is a different profession, and we will happily point you toward it.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You want someone to make the decision for you. We help you decide — we do not decide for you.</li>
              <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You are not ready to be honest about what is actually happening. The free call is a good place to test that.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20 lg:py-24" aria-label="Coaching is not therapy">
      <div class="mx-auto max-w-3xl px-5 lg:px-8">
        <div data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">A Clear Line</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Coaching is not therapy, and it is not a course</h2>
          <p class="mt-5 text-base leading-relaxed text-muted">Therapy usually looks backward — healing what hurt, understanding where a pattern came from. That work matters, and it belongs to trained therapists. Coaching looks forward: you know roughly what you want, and we build the skill to get there. The two can sit side by side, and many of our clients have both.</p>
          <p class="mt-4 text-base leading-relaxed text-muted">A course, meanwhile, gives everyone the same ten videos and hopes one of them fits. Coaching gives you one hour that is entirely about your situation — your meeting, your conversation, your decision. The tools are standard; the application is always personal.</p>
          <p class="mt-4 text-base leading-relaxed text-muted">That is also why we keep programmes small and 1-to-1. Personality is not a subject you study. It is a set of habits you practise — in real conversations, with real stakes, one week at a time.</p>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20 lg:py-24" aria-label="Our values">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="text-center" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">What We Believe</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Four things we never compromise on</h2>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {values.map((v) => (
            <article class="rounded-[2rem] bg-white px-6 py-8 shadow-sm">
              <h3 class="font-display text-[20px] font-semibold text-ink">{v.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted">{v.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="Timeline">
      <div class="mx-auto max-w-3xl px-5 lg:px-8">
        <div class="text-center" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">The Journey</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Fourteen years, one idea</h2>
        </div>
        <ol class="mt-12 space-y-6" data-reveal-group>
          {timeline.map((t) => (
            <li class="flex gap-5 rounded-[1.5rem] bg-white px-6 py-5 shadow-sm">
              <span class="font-display text-2xl font-bold text-rose-deep">{t.year}</span>
              <span class="text-[15px] leading-relaxed text-muted">{t.text}</span>
            </li>
          ))}
        </ol>
        <div class="mt-12 text-center" data-reveal>
          <a href="/book" class="inline-flex min-h-12 items-center rounded-full bg-rose px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Start your story →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
