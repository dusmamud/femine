---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const slug = (id: string) => id.replace(/\.md$/, '');
const categories = [...new Set(posts.map((p) => p.data.category))];
const filters = ['All', ...categories];
---
<Layout title="Blog — Femine" description="Practical, honest writing on confidence, relationships and career growth from the Femine coaching team." ogImage="https://femine.pages.dev/og-blog.png">
  <Header />
  <main id="main">
    <PageHero eyebrow="Blog" title="Small ideas that actually help" text="No hype, no ten-step morning routines. Just practical thinking on confidence, relationships and work — written by coaches, not content mills." crumb="Blog" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter articles by category" data-reveal>
          {filters.map((f) => (
            <button
              type="button"
              data-filter={f}
              aria-pressed={f === 'All' ? 'true' : 'false'}
              class={'min-h-11 rounded-full border px-5 text-sm font-medium transition ' + (f === 'All' ? 'border-wine bg-wine text-white shadow-md shadow-wine/25' : 'border-ink/10 bg-white text-ink hover:border-wine')}
            >
              {f}
            </button>
          ))}
        </div>

        <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {posts.map((p) => (
            <article data-category={p.data.category} class="flex flex-col overflow-hidden rounded-[2rem] bg-cream shadow-sm transition hover:shadow-lg">
              <a href={`/blog/${slug(p.id)}`} class="block" aria-label={p.data.title}>
                <Picture src={p.data.image} alt={p.data.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 767px) calc(100vw - 40px), 349px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="lazy" class="aspect-[16/10] w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col px-6 py-6">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-medium text-muted">
                  <span class="whitespace-nowrap rounded-full bg-white px-3 py-1 text-[12px] font-semibold text-wine">{p.data.category}</span>
                  <span class="whitespace-nowrap">{fmt(p.data.pubDate)}</span><span aria-hidden="true">·</span><span class="whitespace-nowrap">{p.data.readingMinutes} min read</span>
                </p>
                <h2 class="mt-3 font-display text-[22px] font-semibold leading-snug text-ink">
                  <a href={`/blog/${slug(p.id)}`} class="hover:text-wine">{p.data.title}</a>
                </h2>
                <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{p.data.excerpt}</p>
                <a href={`/blog/${slug(p.id)}`} class="mt-5 inline-flex min-h-11 w-fit items-center text-[15px] font-medium text-wine hover:underline">Read article →</a>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-16 rounded-[2rem] bg-wine px-6 py-10 text-center text-white sm:px-10" data-reveal>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">Want help applying any of this?</h2>
          <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-white/80">Reading helps. Practising with a coach helps faster. Your first 30-minute session is free.</p>
          <a href="/book" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-white px-8 text-[15px] font-medium text-wine shadow-lg transition hover:bg-cream">Book your free session →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  // Category filter chips — plain JS only, no define:vars, no `as` casts.
  var chips = document.querySelectorAll('[data-filter]');
  var cards = document.querySelectorAll('[data-category]');
  var activeChipClasses = ['border-wine', 'bg-wine', 'text-white', 'shadow-md', 'shadow-wine/25'];
  var idleChipClasses = ['border-ink/10', 'bg-white', 'text-ink'];
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var filter = chip.getAttribute('data-filter');
      chips.forEach(function (c) {
        var active = c === chip;
        c.setAttribute('aria-pressed', String(active));
        activeChipClasses.forEach(function (cls) { c.classList.toggle(cls, active); });
        idleChipClasses.forEach(function (cls) { c.classList.toggle(cls, !active); });
      });
      cards.forEach(function (card) {
        var show = filter === 'All' || card.getAttribute('data-category') === filter;
        card.classList.toggle('hidden', !show);
      });
    });
  });
</script>
