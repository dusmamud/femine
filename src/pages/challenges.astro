---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { contact } from '../data/site';

// The 7 days, exactly as printed in the free guide (chapter 05,
// "Your 7-day confidence plan") — one small brave thing a day.
const days = [
  { n: '01', title: 'Say hello first', text: 'Say hello first to someone you usually wait for — before they say it to you.' },
  { n: '02', title: 'Speak up once', text: 'Share one idea in a meeting, using the 3-sentence method from the free guide.' },
  { n: '03', title: 'Say one kind no', text: 'Say no to one small thing, kindly and without over-explaining.' },
  { n: '04', title: 'Ask for what you want', text: 'A deadline change, a better seat, a fair split — ask for one thing you want.' },
  { n: '05', title: 'Compliment honestly', text: 'Give one honest compliment to a colleague — specific, not flattery.' },
  { n: '06', title: 'Decide one thing', text: 'Use the decision filter on one decision you have been avoiding.' },
  { n: '07', title: 'Keep the list', text: 'Write down three things you did bravely this week. Keep the list.' },
];
const challengesLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/challenges/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
  ],
};
---
<Layout title="7-Day Confidence Challenge — Femine" description="One small brave thing a day for seven days — with one short email a day to keep you going. Free, from Femine's Confidence First-Aid Kit." jsonLd={challengesLd}>
  <Header />
  <main id="main">
    <PageHero eyebrow="7-Day Confidence Challenge" title="Seven days. Seven small brave things." text="One short email a day for 7 days — each with one small thing to try. Free, no card needed." crumb="7-Day Challenge" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1.2fr_1fr] lg:gap-16 lg:px-8">
        <div data-reveal>
          <h2 class="fluid-h2 font-display font-semibold text-ink">Your seven days</h2>
          <p class="lead-answer mt-4 text-lg font-medium leading-relaxed text-ink">The 7-Day Confidence Challenge is Femine&rsquo;s free week-long challenge from the Confidence First-Aid Kit: one small brave thing a day for seven days, with one short email a day to keep you going. No preparation, no homework — each day takes a few minutes.</p>
          <ol class="mt-8 space-y-6">
            {days.map((d) => (
              <li class="flex gap-5">
                <span class="font-display text-2xl font-bold text-rose-deep" aria-hidden="true">{d.n}</span>
                <div>
                  <h3 class="font-display text-lg font-semibold text-ink">Day {Number(d.n)} — {d.title}</h3>
                  <p class="mt-1 text-[15px] leading-relaxed text-muted">{d.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="mt-9 text-sm leading-relaxed text-muted">These seven days are chapter 05 of the free guide — <a href="/free-guide" class="font-medium text-wine hover:underline">The Confidence First-Aid Kit</a>. The guide&rsquo;s PDF (<a href="/free-guide.pdf" class="font-medium text-wine hover:underline">download the PDF →</a>) is the companion to this challenge: it explains the 2-minute reset, the 3-sentence method and the decision filter the days refer to.</p>
        </div>

        <div data-reveal>
          <form id="challenge-form" data-email={contact.email} class="rounded-[2rem] bg-cream px-6 py-8 sm:px-8 lg:sticky lg:top-24" novalidate>
            <h2 class="font-display text-2xl font-semibold text-ink">Join the challenge</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Enter your name and email. One short email a day for 7 days — that is all. Unsubscribe anytime.</p>
            <div class="mt-6">
              <label for="challenge-name" class="mb-2 block text-sm font-medium text-ink">Your name *</label>
              <input id="challenge-name" type="text" required autocomplete="name" placeholder="Your full name" class="min-h-12 w-full rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none" />
            </div>
            <div class="mt-5">
              <label for="challenge-email" class="mb-2 block text-sm font-medium text-ink">Email address *</label>
              <input id="challenge-email" type="email" required autocomplete="email" placeholder="you@example.com" class="min-h-12 w-full rounded-2xl border border-ink/10 bg-white px-4 text-[15px] focus:border-wine focus:outline-none" />
            </div>
            <p id="challenge-error" class="mt-4 hidden text-sm font-medium text-rose-deep" role="alert"></p>
            <p id="challenge-success" class="mt-4 hidden rounded-2xl bg-white px-4 py-3 text-sm font-medium text-wine" role="status"></p>
            <button type="submit" class="mt-6 inline-flex min-h-12 w-full cursor-pointer items-center justify-center rounded-full bg-rose px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Start Day 1 →</button>
            <p class="mt-3 text-center text-[13px] text-muted">Your signup opens in your own email app — nothing is stored on this website.</p>
          </form>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline data-astro-rerun>
  // Challenge signup (demo): no backend on this static site, so a valid
  // submission opens the visitor's own email app with the signup prefilled.
  // Plain JS only — no define:vars, no `as` casts.
  var form = document.getElementById('challenge-form');
  if (form) form.addEventListener('submit', function (e) {
    e.preventDefault();
    var err = document.getElementById('challenge-error');
    var ok = document.getElementById('challenge-success');
    var nameEl = document.getElementById('challenge-name');
    var emailEl = document.getElementById('challenge-email');
    var name = nameEl ? nameEl.value.trim() : '';
    var email = emailEl ? emailEl.value.trim() : '';
    if (!name) {
      if (err) { err.textContent = 'Please enter your name.'; err.classList.remove('hidden'); }
      if (nameEl) nameEl.focus();
      return;
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      if (err) { err.textContent = 'Please enter a valid email address.'; err.classList.remove('hidden'); }
      if (emailEl) emailEl.focus();
      return;
    }
    if (err) err.classList.add('hidden');
    var to = form.getAttribute('data-email') || '';
    var subject = encodeURIComponent('7-Day Confidence Challenge signup — ' + name);
    var body = encodeURIComponent('Name: ' + name + '\nEmail: ' + email + '\n\nPlease sign me up for the 7-Day Confidence Challenge — one short email a day for 7 days.');
    if (ok) {
      ok.textContent = 'Thank you, ' + name.split(' ')[0] + ' — your email app should have opened with the signup ready. Just press send, and Day 1 will reach you shortly.';
      ok.classList.remove('hidden');
    }
    setTimeout(function () {
      window.location.href = 'mailto:' + to + '?subject=' + subject + '&body=' + body;
    }, 300);
  });
</script>
