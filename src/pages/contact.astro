---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import contactImg from '../assets/contact.jpg';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import PageHero from '../components/PageHero.astro';
import { faqs } from '../data/services';
import { contact } from '../data/site';
import ContactForm from '../components/ContactForm.astro';

interface InfoCard { title: string; text: string; href?: string; label?: string; }
const info: InfoCard[] = [
  { title: 'Email us', text: contact.email, href: `mailto:${contact.email}`, label: `${contact.email} →` },
  { title: 'Call or WhatsApp', text: `${contact.phoneDisplay} · Mon–Sat, 10am–7pm IST`, href: contact.whatsapp, label: 'Chat on WhatsApp →' },
  { title: 'Online sessions', text: 'Video call, from anywhere in the world. All you need is a quiet room.' },
  { title: 'Timings', text: 'Monday to Saturday, 10am – 7pm IST. Sunday is a rest day — for us too.' },
  { title: 'Reply time', text: 'We reply to every message within 24 hours, usually much faster.' },
];
---
<Layout title="Contact Us — Femine" description="Book your free 30-minute session with Femine. Tell us what you want to work on and we will reply within 24 hours.">
  <Header />
  <main id="main">
    <PageHero eyebrow="Contact Us" title="Tell us where you want to go" text="Your first 30-minute call is free. Fill in the form and it will open in your email app — just press send." crumb="Contact Us" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1.4fr_1fr] lg:gap-16 lg:px-8">
        <ContactForm />

        <div class="space-y-5" data-reveal>
          <figure class="relative overflow-hidden rounded-[2rem] shadow-lg shadow-rose/10">
            <Picture src={contactImg} alt="A warm handshake — the start of working together" widths={[480, 960]} sizes="(max-width: 1024px) 100vw, 40vw" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="eager" fetchpriority="high" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="absolute bottom-3 left-3 rounded-full bg-white px-4 py-2 text-[13px] font-medium text-ink shadow">✦ We reply within 24 hours</figcaption>
          </figure>
          {info.map((c) => (
            <div class="rounded-[2rem] bg-cream px-6 py-6">
              <h2 class="font-display text-xl font-semibold text-ink">{c.title}</h2>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{c.text}</p>
              {c.href && <p class="mt-3"><a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})} class="text-[15px] font-medium text-wine hover:underline">{c.label}</a></p>}
            </div>
          ))}
          <div class="rounded-[2rem] bg-wine px-6 py-6 text-white">
            <h2 class="font-display text-xl font-semibold">Prefer to start small?</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-white/80">Read the FAQ on the home page, or book the free call and ask us anything — that is what it is for.</p>
            <a href="/#faq" class="mt-4 inline-block font-medium text-white underline underline-offset-4">See frequently asked questions →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20" aria-label="Contact FAQ">
      <div class="mx-auto max-w-3xl px-5 lg:px-8">
        <h2 class="text-center font-display text-[28px] font-semibold text-ink sm:text-[32px]" data-reveal>Before you write…</h2>
        <div class="mt-10" data-reveal-group>
          <Faq id="contact-faq" items={faqs.slice(0, 3)} />
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

