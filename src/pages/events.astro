---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { nextWorkshop } from '../data/site';

const eventsLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/events/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
    {
      '@type': 'Event',
      name: nextWorkshop.title,
      description: 'A 3-hour in-person Femine workshop in Mumbai — live practice, the 3-sentence method for speaking up, the decision filter, a printed workbook and the 7-day confidence plan. Maximum 12 seats.',
      startDate: '2026-11-28T10:00:00+05:30',
      endDate: '2026-11-28T13:00:00+05:30',
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: 'Mumbai — venue confirmed after booking',
        address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressCountry: 'IN' },
      },
      organizer: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' },
    },
  ],
};
---
<Layout title="Events & Workshops — Femine" description="Femine's next in-person workshop in Mumbai and corporate workshops for teams — small groups, practical role-play, and tools you use the next day." jsonLd={eventsLd}>
  <Header />
  <main id="main">
    <PageHero eyebrow="Events & Workshops" title="Learn it live, practise it the same day" text="Small in-person workshops in Mumbai — and corporate workshops for teams, online or on-site." crumb="Events & Workshops" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="max-w-3xl" data-reveal>
          <p class="lead-answer mt-4 text-lg font-medium leading-relaxed text-ink">Femine runs small in-person workshops in Mumbai — one Saturday morning at a time, 3 hours, maximum 12 seats — and corporate workshops for teams of 8 to 40, online or on-site. Both are practical: you rehearse real situations, not just listen to slides.</p>
        </div>

        <!-- ============ NEXT WORKSHOP ============ -->
        <div class="mt-14" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Next Workshop</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Our next in-person workshop</h2>
        </div>
        <div class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_1fr]" data-reveal-group>
          <article class="rounded-[2rem] bg-cream px-6 py-8 sm:px-8">
            <h3 class="font-display text-2xl font-semibold text-ink">{nextWorkshop.title}</h3>
            <dl class="mt-6 space-y-3 text-[15px] leading-relaxed">
              <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-ink">When</dt><dd class="text-muted">{nextWorkshop.date} · {nextWorkshop.time}</dd></div>
              <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-ink">Length</dt><dd class="text-muted">{nextWorkshop.duration} session</dd></div>
              <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-ink">Where</dt><dd class="text-muted">{nextWorkshop.city} — {nextWorkshop.venue}</dd></div>
              <div class="flex gap-3"><dt class="w-24 shrink-0 font-semibold text-ink">Seats</dt><dd class="text-muted">Maximum {nextWorkshop.seats} — small group, everyone practises</dd></div>
            </dl>
            <p class="mt-6 text-sm leading-relaxed text-muted">Dates and venues are confirmed after booking — write to us and we will hold your seat and share the details.</p>
          </article>
          <article class="rounded-[2rem] bg-white px-6 py-8 shadow-sm">
            <h3 class="font-display text-xl font-semibold text-ink">What you get</h3>
            <ul class="mt-4 space-y-3 text-[15px] leading-relaxed text-muted">
              {nextWorkshop.includes.map((item) => (
                <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>{item}</li>
              ))}
            </ul>
            <a href="/book" class="mt-7 inline-flex min-h-12 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Book a free call to reserve →</a>
          </article>
        </div>

        <!-- ============ CORPORATE ============ -->
        <div class="mt-16 rounded-[2rem] bg-cream px-6 py-8 sm:px-10" data-reveal>
          <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
            <div class="max-w-xl">
              <h2 class="font-display text-[22px] font-semibold text-ink">Corporate workshops for your team</h2>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">Half-day, 3-hour workshops for teams of 8 to 40 — communication, presentation skills, feedback without friction, and leadership presence. Designed around your team&rsquo;s real challenges, online or on-site. From ₹14,999.</p>
            </div>
            <a href="/contact" class="inline-flex min-h-12 shrink-0 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Enquire for your team →</a>
          </div>
        </div>

        <div class="mt-16 text-center" data-reveal>
          <h2 class="font-display text-2xl font-semibold text-ink">Not sure a workshop is right for you?</h2>
          <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-muted">Book a free 30-minute call first. We will talk about what you want to change and tell you honestly whether a workshop, a programme, or nothing at all is the best next step.</p>
          <a href="/book" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Book your free call →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
