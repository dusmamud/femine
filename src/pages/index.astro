---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Faq from '../components/Faq.astro';
import Branch from '../components/Branch.astro';
import heroImg from '../assets/hero.jpg';
import welcomeImg from '../assets/welcome.jpg';
import expertiseImg from '../assets/expertise.jpg';
import avatarAnanya from '../assets/avatar-ananya.jpg';
import avatarPriya from '../assets/avatar-priya.jpg';
import avatarKavya from '../assets/avatar-kavya.jpg';
import { getCollection } from 'astro:content';
import { services, faqs } from '../data/services';
import { testimonials } from '../data/testimonials';
import { outcomeStats } from '../data/results';

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const postSlug = (id: string) => id.replace(/\.md$/, '');
const fmtDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const skills = [
  { label: 'Confidence', value: 85 },
  { label: 'Communication', value: 90 },
  { label: 'Leadership', value: 75 },
];

const steps = [
  { n: '01', title: 'Book a free call', text: 'A relaxed 30-minute chat. We talk about where you are and what you want to change — no pressure, no obligation.' },
  { n: '02', title: 'Get your personal plan', text: 'Together we pick the right programme and set clear, small goals. You always know exactly what we are working on and why.' },
  { n: '03', title: 'Practice, week by week', text: 'Weekly 60-minute sessions with simple exercises between them. Small changes, repeated — that is how personality actually transforms.' },
];

const marqueeItems = ['Confidence', 'Self Growth', 'Relationships', 'Career', 'Communication', 'Leadership'];

const problems = [
  'I rehearse what to say in the meeting — then stay quiet anyway.',
  'I say yes to everything, then resent it all week.',
  'I know I am good at my work. Nobody else seems to notice.',
  'I have three career ideas — and zero decisions.',
];

const orgLd = {
  '@type': 'ProfessionalService',
  name: 'Femine',
  url: 'https://femine.pages.dev',
  description: 'Personal coaching for confidence, relationships, passion and career growth.',
  priceRange: '₹1,999–₹14,999',
  telephone: '+91 98765 43210',
  email: 'hello@femine.in',
  image: 'https://femine.pages.dev/og.png',
  address: { '@type': 'PostalAddress', addressCountry: 'IN' },
  areaServed: 'India',
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '10:00',
    closes: '19:00',
  },
  sameAs: [
    'https://www.instagram.com/femine.coaching',
    'https://www.facebook.com/femine.coaching',
  ],
  logo: 'https://femine.pages.dev/logo-mark.svg',
  founder: {
    '@type': 'Person',
    name: 'Meera Kapoor',
    jobTitle: 'Founder & Lead Coach',
    knowsAbout: ['Confidence coaching', 'Communication skills', 'Career growth', 'Relationships'],
  },
  aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '500' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Coaching programmes',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Problem Solving Coaching', provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' } }, price: 1999, priceCurrency: 'INR', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Relationships Coaching', provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' } }, price: 1999, priceCurrency: 'INR', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Identifying Passion Coaching', provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' } }, price: 1999, priceCurrency: 'INR', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Growth Career Coaching', provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' } }, price: 1999, priceCurrency: 'INR', availability: 'https://schema.org/InStock' },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Corporate Workshops', provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' } }, price: 14999, priceCurrency: 'INR', availability: 'https://schema.org/InStock' },
    ],
  },
};
const pageLd = {
  '@context': 'https://schema.org',
  '@graph': [
    orgLd,
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.slice(0, 5).map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Layout jsonLd={pageLd}>
  <Header />
  <main id="main">
  <!-- ============ HERO ============ -->
  <section id="home" class="curve-bottom overflow-hidden bg-cream pb-16 pt-32 sm:pb-20 lg:pb-24 lg:pt-36">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 sm:gap-12 lg:grid-cols-2 lg:gap-6 lg:px-8">
      <div class="relative">
        <p data-hero class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">For women who know they&rsquo;re capable — and are ready to show it</p>
        <svg data-hero class="sparkle-twinkle absolute -right-2 top-10 hidden h-6 w-6 text-rose sm:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z"/></svg>
        <svg data-hero class="sparkle-twinkle absolute -right-8 top-24 hidden h-4 w-4 text-wine sm:block" style="animation-delay:1.2s" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z"/></svg>
        <h1 data-hero-lines class="fluid-h1 mt-4 font-display font-semibold text-ink">
          <span class="mask-line"><span>Your Personality is</span></span>
          <span class="mask-line"><span>What Makes You</span></span>
          <span class="mask-line"><span>Character</span></span>
        </h1>
        <p data-hero class="lead-answer mt-5 max-w-md text-base leading-relaxed text-muted sm:text-[17px]">
          Confidence is not something you are born with — it is something you practise.
          Femine gives you practical, one-to-one coaching to speak up, decide clearly
          and grow into the person you want to be.
        </p>
        <div data-hero class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#welcome" class="magnetic inline-flex min-h-12 items-center rounded-full bg-rose-btn px-7 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep active:scale-[0.98]">Discover Femine</a>
          <button type="button" data-video-open class="group inline-flex min-h-12 cursor-pointer items-center gap-3 rounded-full pr-2 text-[15px] font-medium text-ink">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-white shadow-md transition group-hover:scale-105 group-active:scale-95">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5-9-5.5z" fill="#d96f6f"/></svg>
            </span>
            Watch intro
          </button>
        </div>
        <div data-hero class="mt-8 flex items-center gap-3">
          <span class="flex -space-x-2" aria-hidden="true">
            <Picture src={avatarAnanya} alt="" widths={[72]} sizes="36px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="eager" class="h-9 w-9 rounded-full object-cover ring-2 ring-cream" />
            <Picture src={avatarPriya} alt="" widths={[72]} sizes="36px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="eager" class="h-9 w-9 rounded-full object-cover ring-2 ring-cream" />
            <Picture src={avatarKavya} alt="" widths={[72]} sizes="36px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="eager" class="h-9 w-9 rounded-full object-cover ring-2 ring-cream" />
          </span>
          <div class="text-sm leading-tight">
            <span class="flex gap-0.5 text-rose-deep" role="img" aria-label="Rated 4.9 out of 5">
              {Array.from({ length: 5 }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
              ))}
            </span>
            <span class="text-muted"><strong class="font-semibold text-ink">4.9/5</strong> · 500+ women transformed</span>
          </div>
        </div>
      </div>

      <div data-hero-img class="relative mx-auto w-full max-w-[340px] sm:max-w-[420px]">
        <div class="arch relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
          <Picture src={heroImg} alt="Smiling woman holding a notebook" widths={[360, 420, 560, 720]} sizes="(max-width: 640px) 340px, 420px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="eager" fetchpriority="high" class="kenburns aspect-[3/4] w-full object-cover object-top" data-parallax />
        </div>
        <Branch class="branch-sway absolute -left-10 bottom-2 hidden h-64 w-auto sm:block lg:-left-16" />
        <div class="absolute -right-2 top-1/2 flex -translate-y-1/2 flex-col gap-3 lg:-right-6" aria-hidden="true">
          <span class="float-soft h-4 w-4 rounded-full bg-blush-soft"></span>
          <span class="float-soft h-4 w-4 rounded-full bg-blush" style="animation-delay:.5s"></span>
          <span class="float-soft h-4 w-4 rounded-full bg-wine" style="animation-delay:1s"></span>
        </div>
        <p class="absolute -bottom-4 left-1/2 w-max -translate-x-1/2 rounded-full bg-white px-4 py-2 text-[13px] font-medium text-ink shadow-lg sm:left-6 sm:translate-x-0">✦ First session free</p>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee overflow-hidden border-y border-rose/15 bg-white py-3.5" aria-label="What we help with">
    <div class="marquee-track flex w-max items-center gap-8">
      {[0, 1].map((copy) => (
        <span class="flex items-center gap-8" aria-hidden={copy === 1}>
          {marqueeItems.map((item) => (
            <span class="flex items-center gap-8 whitespace-nowrap font-display text-lg font-semibold text-wine">
              {item}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z" fill="#e78f8f"/></svg>
            </span>
          ))}
        </span>
      ))}
    </div>
  </div>

  <!-- ============ WELCOME / ABOUT ============ -->
  <section id="welcome" class="relative scroll-mt-24 overflow-hidden bg-white py-16 sm:py-20 lg:py-24">
    <span class="watermark watermark-about -top-2 left-1/2 -translate-x-1/2 text-[64px] sm:text-[120px]" aria-hidden="true"></span>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 sm:gap-12 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div class="relative mx-auto w-full max-w-[340px] sm:max-w-[420px]" data-reveal>
        <div class="arch relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
          <Picture src={welcomeImg} alt="Woman looking up with confidence" widths={[360, 420, 560, 720]} sizes="(max-width: 640px) 340px, 420px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="lazy" class="clip-reveal-img aspect-[4/5] w-full object-cover object-top" />
        </div>
        <Branch class="branch-sway absolute -left-8 bottom-2 hidden h-60 w-auto sm:block lg:-left-14" />
        <div class="absolute -left-2 top-1/2 flex -translate-y-1/2 flex-col gap-3 lg:-left-6" aria-hidden="true">
          <span class="h-4 w-4 rounded-full bg-blush-soft"></span>
          <span class="h-4 w-4 rounded-full bg-blush"></span>
          <span class="h-4 w-4 rounded-full bg-wine"></span>
        </div>
      </div>

      <div data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">About Us</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Welcome To Femine</h2>
        <p class="mt-5 text-base leading-relaxed text-muted">
          Femine began in 2012 with a simple observation: talented women were holding
          themselves back — not for lack of ability, but for lack of confidence in the
          moments that matter. A job interview. A difficult conversation. A room full
          of people waiting for someone to speak first.
        </p>
        <p class="mt-4 text-base leading-relaxed text-muted">
          Since then we have coached more than 500 women, one conversation at a time.
          No jargon, no lectures, no personality tests that put you in a box — just
          practical tools, honest feedback and steady encouragement.
        </p>
        <dl class="mt-9 grid grid-cols-3 gap-3 sm:gap-4" data-reveal-group>
          <div class="rounded-2xl bg-rose-btn px-2 py-4 text-center text-white sm:px-3">
            <dt class="sr-only">Experience</dt>
            <dd class="font-display text-[28px] font-semibold leading-none sm:text-[32px]"><span data-count="32">32</span></dd>
            <dd class="mt-1.5 text-[12px] sm:text-[13px]">Experience</dd>
          </div>
          <div class="rounded-2xl bg-cream px-2 py-4 text-center sm:px-3">
            <dt class="sr-only">Mentored</dt>
            <dd class="font-display text-[28px] font-semibold leading-none text-ink sm:text-[32px]"><span data-count="82">82</span></dd>
            <dd class="mt-1.5 text-[12px] text-muted sm:text-[13px]">Mentored</dd>
          </div>
          <div class="rounded-2xl bg-cream px-2 py-4 text-center sm:px-3">
            <dt class="sr-only">Certificates</dt>
            <dd class="font-display text-[28px] font-semibold leading-none text-ink sm:text-[32px]"><span data-count="28">28</span></dd>
            <dd class="mt-1.5 text-[12px] text-muted sm:text-[13px]">Certificates</dd>
          </div>
        </dl>
        <a href="/about" class="mt-8 inline-flex min-h-12 items-center rounded-full border-2 border-wine px-7 text-[15px] font-medium text-wine transition hover:bg-wine hover:text-white">Our story →</a>
      </div>
    </div>
  </section>

  <!-- ============ DOES THIS SOUND FAMILIAR ============ -->
  <section class="curve-top relative z-10 -mt-8 bg-cream py-16 sm:py-20 lg:py-24" aria-label="Does this sound familiar">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="text-center" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Does This Sound Familiar?</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">In your own words</h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted">If any of these sound like you, you are exactly who Femine is for.</p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {problems.map((p) => (
          <figure class="rounded-[2rem] bg-white px-6 py-8 shadow-sm">
            <span class="font-display text-4xl font-bold text-rose/40" aria-hidden="true">&ldquo;</span>
            <blockquote class="mt-2 font-display text-[19px] leading-snug text-ink">{p}</blockquote>
          </figure>
        ))}
      </div>
      <p class="mt-10 text-center" data-reveal>
        <a href="/book" class="arrow-link inline-flex min-h-12 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Book a free call <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ============ WHO IT'S FOR ============ -->
  <section class="bg-white py-16 sm:py-20 lg:py-24" aria-label="Who Femine is for">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="text-center" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Is This For You?</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Who Femine is for — and who it isn&rsquo;t</h2>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2" data-reveal-group>
        <div class="rounded-[2rem] bg-cream px-7 py-8">
          <h3 class="font-display text-xl font-semibold text-ink">Femine is for you if&hellip;</h3>
          <ul class="mt-5 space-y-3 text-[15px] leading-relaxed text-muted">
            <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You are good at your work but quiet in the rooms where it counts.</li>
            <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You say yes when you mean no, then resent it all week.</li>
            <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✓</span>You want practical tools, not motivational speeches.</li>
          </ul>
        </div>
        <div class="rounded-[2rem] bg-cream px-7 py-8">
          <h3 class="font-display text-xl font-semibold text-ink">Femine is probably not for you if&hellip;</h3>
          <ul class="mt-5 space-y-3 text-[15px] leading-relaxed text-muted">
            <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You want a quick fix with no practice in between sessions.</li>
            <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You are looking for therapy or clinical help — that is a different profession, and we will happily point you toward it.</li>
            <li class="flex gap-3"><span class="text-rose-deep" aria-hidden="true">✦</span>You want someone to make the decision for you. We help you decide — we do not decide for you.</li>
          </ul>
        </div>
      </div>
      <p class="mt-8 text-center" data-reveal>
        <a href="/about" class="arrow-link text-[15px] font-medium text-wine hover:underline">Read the full picture on About Us <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="relative scroll-mt-24 overflow-hidden bg-cream py-16 sm:py-20 lg:py-24">
    <span class="watermark watermark-services top-6 left-1/2 -translate-x-1/2 text-[56px] sm:text-[110px]" aria-hidden="true"></span>
    <div class="relative mx-auto max-w-6xl px-5 lg:px-8">
      <div class="text-center" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Our Services</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">We Can Help Transform You</h2>
        <p class="mx-auto mt-3 max-w-lg text-base text-muted">Five focused programmes — pick one, or combine them into your own growth plan.</p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-6" data-reveal-group>
        {services.slice(0, 4).map((s) => (
          <article class={`group relative px-2 py-2 text-center ${s.slug === 'relationships' ? 'rounded-[2rem] bg-rose-btn px-6 py-9 text-white shadow-xl shadow-rose/30' : 'text-ink'}`}>
            <span class={`mx-auto grid h-14 w-14 place-items-center rounded-full transition duration-300 group-hover:scale-110 ${s.slug === 'relationships' ? 'bg-white/20 text-white' : 'bg-white text-wine shadow-sm'}`}>
              {s.icon === 'bulb' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.2 1.1 2.2h5c0-1 .4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg>}
              {s.icon === 'heart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.3-9.3-9A5.2 5.2 0 0 1 12 6.5 5.2 5.2 0 0 1 21.3 11C19 15.7 12 20 12 20z"/><path d="M12 6.5L14 9l2.5.5"/></svg>}
              {s.icon === 'target' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>}
              {s.icon === 'chart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18M7 16v-5M12 16V8M17 16v-3"/></svg>}
              {s.icon === 'users' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
            </span>
            <h3 class="mt-5 font-display text-[21px] font-semibold">{s.title}</h3>
            <p class={`mt-2.5 text-sm leading-relaxed ${s.slug === 'relationships' ? 'text-white/85' : 'text-muted'}`}>{s.short}</p>
            <a href={`/services/${s.slug}`} aria-label={`Learn more about ${s.title} coaching`} class={`arrow-link mt-4 inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-sm font-medium ${s.slug === 'relationships' ? 'text-white' : 'text-wine hover:text-rose-deep'}`}>
              Learn More <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
      <p class="mt-10 text-center" data-reveal>
        <a href="/services/corporate-workshops" class="arrow-link text-[15px] font-medium text-wine hover:underline">Corporate Workshops for teams <span aria-hidden="true">→</span></a>
        <span class="mx-3 text-muted" aria-hidden="true">·</span>
        <a href="/services" class="arrow-link text-[15px] font-medium text-wine hover:underline">View all services <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="curve-top relative z-10 -mt-8 bg-white py-16 sm:py-20 lg:py-24" aria-label="How it works">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="text-center" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">How It Works</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Three Steps To A New You</h2>
      </div>
      <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-6" data-reveal-group>
        {steps.map((st) => (
          <li class="relative rounded-[2rem] bg-cream px-7 py-8 text-center">
            <span class="font-display text-5xl font-bold text-rose/40" aria-hidden="true">{st.n}</span>
            <h3 class="mt-3 font-display text-[21px] font-semibold text-ink">{st.title}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-muted">{st.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section id="stories" class="relative scroll-mt-24 overflow-hidden bg-cream py-16 sm:py-20 lg:py-24" aria-label="Client stories">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="text-center" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Client Stories</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Loved By Our Clients</h2>
      </div>
      <div class="t-slider relative mt-12 overflow-hidden" data-testimonial-slider data-reveal>
        <div class="t-track flex transition-transform duration-500 ease-out">
          {testimonials.map((t) => (
            <figure class="w-full shrink-0 px-1">
              <div class="mx-auto max-w-2xl rounded-[2rem] bg-white px-6 py-10 text-center shadow-sm sm:px-10">
                <span class="mx-auto flex justify-center gap-0.5 text-rose-deep" role="img" aria-label="5 out of 5 stars">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
                  ))}
                </span>
                <blockquote class="mt-5 font-display text-[21px] leading-snug text-ink sm:text-[24px]">“{t.quote}”</blockquote>
                <figcaption class="mt-6 flex items-center justify-center gap-3">
                  <Picture src={t.img} alt={`Portrait of ${t.name}`} widths={[96]} sizes="44px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="eager" class="h-11 w-11 rounded-full object-cover ring-2 ring-cream" />
                  <span class="text-left"><span class="block text-sm font-semibold text-ink">{t.name}</span><span class="block text-[13px] text-muted">{t.role} · {t.programme}</span></span>
                </figcaption>
              </div>
            </figure>
          ))}
        </div>
        <div class="mt-7 flex items-center justify-center gap-4">
          <button type="button" data-t-prev aria-label="Previous story" class="grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-white text-wine shadow-sm transition hover:bg-blush-soft">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <div class="t-dots flex items-center gap-2" role="tablist" aria-label="Choose a story">
            {testimonials.map((_, i) => (
              <button type="button" data-t-dot={i} role="tab" aria-label={`Story ${i + 1}`} class={`h-2.5 cursor-pointer rounded-full transition-all duration-300 ${i === 0 ? 'w-7 bg-rose' : 'w-2.5 bg-rose/30 hover:bg-rose/60'}`}></button>
            ))}
          </div>
          <button type="button" data-t-next aria-label="Next story" class="grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-white text-wine shadow-sm transition hover:bg-blush-soft">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
      <p class="mt-10 text-center" data-reveal>
        <a href="/testimonials" class="inline-flex min-h-12 items-center rounded-full bg-white px-7 text-[15px] font-medium text-wine shadow-sm transition hover:bg-blush-soft">Read all client stories →</a>
      </p>
    </div>
  </section>

  <!-- ============ RESULTS STRIP ============ -->
  <section class="bg-cream px-5 py-4 sm:py-6" aria-label="Results">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-[2rem] bg-wine px-6 py-10 text-white sm:px-10" data-reveal>
        <div class="grid gap-8 text-center sm:grid-cols-2 lg:grid-cols-4">
          {outcomeStats.map((s) => (
            <div>
              <p class="font-display text-3xl font-bold sm:text-4xl">{s.value}</p>
              <p class="mt-2 text-sm leading-relaxed text-white/80">{s.label}</p>
            </div>
          ))}
        </div>
        <p class="mt-8 text-center">
          <a href="/results" class="inline-flex min-h-12 items-center rounded-full bg-white px-7 text-[15px] font-medium text-wine shadow-lg transition hover:bg-cream">See real client results →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ FROM THE BLOG ============ -->
  <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="From the blog">
    <div class="mx-auto max-w-6xl px-5 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">From the Blog</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Small ideas that actually help</h2>
        </div>
        <a href="/blog" class="text-[15px] font-medium text-wine hover:underline">View all articles →</a>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3" data-reveal-group>
        {latestPosts.map((p) => (
          <article class="blog-card flex flex-col overflow-hidden rounded-[2rem] bg-white shadow-sm transition hover:shadow-lg">
            <a href={`/blog/${postSlug(p.id)}`} class="block" aria-label={p.data.title}>
              <Picture src={p.data.image} alt={p.data.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 767px) calc(100vw - 40px), 349px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="lazy" class="aspect-[16/10] w-full object-cover" />
            </a>
            <div class="flex flex-1 flex-col px-6 py-6">
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-medium text-muted">
                <span class="whitespace-nowrap rounded-full bg-cream px-3 py-1 text-[12px] font-semibold text-wine">{p.data.category}</span>
                <span class="whitespace-nowrap">{fmtDate(p.data.pubDate)}</span><span aria-hidden="true">·</span><span class="whitespace-nowrap">{p.data.readingMinutes} min read</span>
              </p>
              <h3 class="mt-3 font-display text-[20px] font-semibold leading-snug text-ink">
                <a href={`/blog/${postSlug(p.id)}`} class="hover:text-wine">{p.data.title}</a>
              </h3>
              <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{p.data.excerpt}</p>
              <a href={`/blog/${postSlug(p.id)}`} class="mt-5 inline-flex min-h-11 w-fit items-center text-[15px] font-medium text-wine hover:underline">Read article →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EXPERTISE ============ -->
  <section id="expertise" class="curve-top relative z-10 -mt-8 scroll-mt-24 overflow-hidden bg-white py-16 sm:py-20 lg:pb-24 lg:pt-20">
    <span class="watermark watermark-about left-1/2 top-2 -translate-x-1/2 text-[48px] sm:text-[84px]" aria-hidden="true"></span>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 sm:gap-12 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Our Expertise</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Proving Our Expertise</h2>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-muted">
          We measure what matters. After every programme we ask clients to rate
          themselves — before and after — on the skills they came to build. These
          are the average improvements our clients report.
        </p>
        <div class="mt-8 max-w-lg space-y-5">
          {skills.map((sk) => (
            <div>
              <div class="flex items-center justify-between text-sm font-medium">
                <span class="text-ink">{sk.label}</span><span class="text-wine"><span data-count={sk.value}>{sk.value}</span>%</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-cream" role="progressbar" aria-valuenow={sk.value} aria-valuemin={0} aria-valuemax={100} aria-label={sk.label}>
                <div class="h-full rounded-full bg-rose" data-bar={`${sk.value}%`} style={`width: ${sk.value}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <a href="/services" class="magnetic mt-9 inline-flex min-h-12 items-center rounded-full bg-rose-btn px-7 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep active:scale-[0.98]">See all services</a>
      </div>

      <div class="relative mx-auto w-full max-w-[340px] sm:max-w-[420px]" data-reveal>
        <div class="arch relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
          <Picture src={expertiseImg} alt="Woman in a pink knit sweater smiling" widths={[360, 420, 560, 720]} sizes="(max-width: 640px) 340px, 420px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="lazy" class="clip-reveal-img aspect-[3/4] w-full object-cover object-top" data-parallax />
        </div>
        <Branch class="branch-sway absolute -left-10 bottom-2 hidden h-56 w-auto sm:block lg:-left-16" />
        <div class="absolute -right-2 top-1/2 flex -translate-y-1/2 flex-col gap-3 lg:-right-6" aria-hidden="true">
          <span class="h-4 w-4 rounded-full bg-blush-soft"></span>
          <span class="h-4 w-4 rounded-full bg-blush"></span>
          <span class="h-4 w-4 rounded-full bg-wine"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="scroll-mt-24 bg-cream py-16 sm:py-20 lg:py-24" aria-label="Frequently asked questions">
    <div class="mx-auto max-w-3xl px-5 lg:px-8">
      <div class="text-center" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">FAQ</p>
        <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Questions, Answered</h2>
      </div>
      <div class="mt-10" data-reveal-group>
        <Faq id="home-faq" items={faqs.slice(0, 5)} />
        <p class="mt-8 text-center" data-reveal>
          <a href="/faq" class="text-[15px] font-medium text-wine hover:underline">View all frequently asked questions →</a>
        </p>
      </div>
      <p class="mt-8 text-center text-sm text-muted">Still unsure? <a href="/contact" class="font-semibold text-wine underline underline-offset-4">Ask us anything →</a></p>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="bg-cream px-5 pb-16 sm:pb-20" aria-label="Book a session">
    <div class="mx-auto max-w-6xl rounded-[2rem] bg-wine px-6 py-12 text-center text-white sm:px-10 lg:py-14" data-reveal>
      <p class="mx-auto max-w-xl font-display text-[19px] italic leading-snug text-white/85">“I walked in doubting myself at work. Three months later I led my first team presentation — calmly.” <span class="mt-2 block font-sans text-[13px] font-medium not-italic uppercase tracking-wider text-white/60">Ananya Sharma · Marketing Manager</span></p>
      <h2 class="mt-6 font-display text-[28px] font-semibold leading-tight sm:text-[36px]">Ready to transform yourself?</h2>
      <p class="mx-auto mt-3 max-w-md text-[15px] leading-relaxed text-white/80">Book your first session free — no commitment, just an honest conversation about where you want to go.</p>
      <a href="/book" class="magnetic mt-7 inline-flex min-h-12 items-center rounded-full bg-white px-8 text-[15px] font-semibold text-wine shadow-lg transition hover:bg-cream active:scale-[0.98]">Book Your Free Session</a>
    </div>
  </section>

  <!-- ============ VIDEO LIGHTBOX ============ -->
  <div id="video-modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-ink/85 p-5 backdrop-blur-sm" role="dialog" aria-modal="true" aria-label="Coach introduction video">
    <div class="relative w-full max-w-3xl">
      <video id="video-modal-el" src="/videos/coach-intro.mp4" controls playsinline preload="none" poster="/og-about.png" class="aspect-video w-full rounded-2xl bg-black object-cover"></video>
      <button type="button" data-video-close aria-label="Close video" class="absolute -top-3 -right-3 grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-white text-ink shadow-lg transition hover:bg-blush-soft">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
  </div>
  </main>
  <Footer />
</Layout>
