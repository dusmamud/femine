---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Branch from '../components/Branch.astro';

const services = [
  { icon: 'bulb', title: 'Problem Solving', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing.', active: false },
  { icon: 'heart', title: 'Relationships', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing.', active: true },
  { icon: 'target', title: 'Identifying Passion', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing.', active: false },
  { icon: 'chart', title: 'Growth Career', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing.', active: false },
];

const skills = [
  { label: 'Confidence', value: 85 },
  { label: 'Communication', value: 90 },
  { label: 'Leadership', value: 75 },
];
---
<Layout>
  <Header />

  <!-- ============ HERO ============ -->
  <section id="home" class="curve-bottom overflow-hidden bg-cream pt-28 pb-20 lg:pt-32 lg:pb-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2 lg:gap-6 lg:px-8">
      <div class="relative">
        <svg class="absolute -top-8 right-6 hidden h-12 w-12 sm:block" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <path d="M24 4l3.5 12.5L40 20l-12.5 3.5L24 36l-3.5-12.5L8 20l12.5-3.5L24 4z" fill="#e78f8f"/>
          <path d="M40 30l1.8 6.2L48 38l-6.2 1.8L40 46l-1.8-6.2L32 38l6.2-1.8L40 30z" fill="#6e2434"/>
        </svg>
        <h1 class="font-display text-[42px] font-semibold leading-[1.15] text-ink sm:text-[54px] lg:text-[58px]">
          Your Personality is<br />What Makes You<br />Character
        </h1>
        <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec
          ullamcorper mattis, pulvinar dapibus leo.
        </p>
        <div class="mt-8 flex items-center gap-5">
          <a href="#services" class="rounded-full bg-rose px-7 py-3 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Learn More</a>
          <a href="#about" aria-label="Watch introduction" class="group flex items-center gap-3">
            <span class="grid h-12 w-12 place-items-center rounded-full bg-white shadow-md transition group-hover:scale-105">
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5-9-5.5z" fill="#d96f6f"/></svg>
            </span>
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[420px]">
        <div class="arch relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
          <img src="/images/hero.jpg" alt="Smiling woman holding a notebook" width="900" height="1350" class="aspect-[3/4] w-full object-cover object-top" loading="eager" />
        </div>
        <Branch class="absolute -left-10 bottom-2 hidden h-56 w-auto sm:block lg:-left-16" />
        <div class="absolute -right-2 top-1/2 flex -translate-y-1/2 flex-col gap-3 lg:-right-6" aria-hidden="true">
          <span class="h-4 w-4 rounded-full bg-blush-soft"></span>
          <span class="h-4 w-4 rounded-full bg-blush"></span>
          <span class="h-4 w-4 rounded-full bg-wine"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WELCOME / ABOUT ============ -->
  <section id="about" class="relative overflow-hidden bg-white py-20 lg:py-24">
    <span class="watermark -top-2 left-1/2 -translate-x-1/2 text-[88px] sm:text-[120px]" aria-hidden="true">About Us</span>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div class="relative mx-auto w-full max-w-[420px]">
        <div class="arch-flip relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
          <img src="/images/welcome.jpg" alt="Woman looking up with confidence" width="900" height="1125" class="aspect-[4/5] w-full object-cover object-top" loading="lazy" />
        </div>
        <Branch flip class="absolute -right-8 bottom-2 hidden h-52 w-auto sm:block lg:-right-12" />
        <div class="absolute -left-2 top-1/2 flex -translate-y-1/2 flex-col gap-3 lg:-left-6" aria-hidden="true">
          <span class="h-4 w-4 rounded-full bg-blush-soft"></span>
          <span class="h-4 w-4 rounded-full bg-blush"></span>
          <span class="h-4 w-4 rounded-full bg-wine"></span>
        </div>
      </div>

      <div>
        <h2 class="font-display text-[36px] font-semibold leading-tight text-ink sm:text-[42px]">Welcome To Femine</h2>
        <p class="mt-5 text-[15px] leading-relaxed text-muted">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis
          nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
          Duis aute irure dolor in reprehenderit in voluptate velit esse cillum.
        </p>
        <dl class="mt-9 grid grid-cols-3 gap-4">
          <div class="rounded-2xl bg-rose px-3 py-4 text-center text-white">
            <dt class="sr-only">Experience</dt>
            <dd class="font-display text-[32px] font-semibold leading-none">32</dd>
            <dd class="mt-1.5 text-[13px]">Experience</dd>
          </div>
          <div class="rounded-2xl bg-cream px-3 py-4 text-center">
            <dt class="sr-only">Mentored</dt>
            <dd class="font-display text-[32px] font-semibold leading-none text-ink">82</dd>
            <dd class="mt-1.5 text-[13px] text-muted">Mentored</dd>
          </div>
          <div class="rounded-2xl bg-cream px-3 py-4 text-center">
            <dt class="sr-only">Certificates</dt>
            <dd class="font-display text-[32px] font-semibold leading-none text-ink">28</dd>
            <dd class="mt-1.5 text-[13px] text-muted">Certificates</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="relative overflow-hidden bg-cream py-20 lg:py-24">
    <span class="watermark top-6 left-1/2 -translate-x-1/2 text-[72px] sm:text-[110px]" aria-hidden="true">Our Services</span>
    <div class="relative mx-auto max-w-6xl px-5 lg:px-8">
      <h2 class="text-center font-display text-[36px] font-semibold text-ink sm:text-[42px]">We Can Help Transform You</h2>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <article class={`relative rounded-[2rem] px-6 py-9 text-center transition hover:-translate-y-1 ${s.active ? 'bg-rose text-white shadow-xl shadow-rose/30' : 'bg-white text-ink shadow-sm'}`}>
            <span class={`mx-auto grid h-14 w-14 place-items-center rounded-full ${s.active ? 'bg-white/20 text-white' : 'bg-cream text-wine'}`}>
              {s.icon === 'bulb' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.2 1.1 2.2h5c0-1 .4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg>}
              {s.icon === 'heart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.3-9.3-9A5.2 5.2 0 0 1 12 6.5 5.2 5.2 0 0 1 21.3 11C19 15.7 12 20 12 20z"/><path d="M12 6.5L14 9l2.5.5"/></svg>}
              {s.icon === 'target' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>}
              {s.icon === 'chart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18M7 16v-5M12 16V8M17 16v-3"/></svg>}
            </span>
            <h3 class="mt-5 font-display text-[21px] font-semibold">{s.title}</h3>
            <p class={`mt-2.5 text-[14px] leading-relaxed ${s.active ? 'text-white/85' : 'text-muted'}`}>{s.text}</p>
            <a href="#expertise" class={`mt-5 inline-flex items-center gap-1.5 text-[14px] font-medium ${s.active ? 'text-white' : 'text-wine hover:text-rose-deep'}`}>
              Learn More <span aria-hidden="true">→</span>
            </a>
            {s.active && (
              <svg class="absolute -bottom-3 -left-2 h-10 w-10" viewBox="0 0 40 40" fill="none" aria-hidden="true">
                <path d="M20 4l2.8 10.2L33 17l-10.2 2.8L20 30l-2.8-10.2L7 17l10.2-2.8L20 4z" fill="#fff" opacity="0.9"/>
                <path d="M33 28l1.4 5.1L39.5 34.5l-5.1 1.4L33 41l-1.4-5.1-5.1-1.4 5.1-1.4L33 28z" fill="#6e2434"/>
              </svg>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EXPERTISE ============ -->
  <section id="expertise" class="relative overflow-hidden bg-cream pb-20 pt-4 lg:pb-24">
    <span class="watermark -top-1 left-4 text-[72px] sm:text-[100px] lg:left-24" aria-hidden="true">About Us</span>
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-2 lg:gap-16 lg:px-8">
      <div>
        <h2 class="font-display text-[36px] font-semibold leading-tight text-ink sm:text-[42px]">Proving Our Expertise</h2>
        <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-muted">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
          incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis
          nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
        <div class="mt-8 max-w-lg space-y-5">
          {skills.map((sk) => (
            <div>
              <div class="flex items-center justify-between text-[14px] font-medium">
                <span class="text-ink">{sk.label}</span><span class="text-wine">{sk.value}%</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-white" role="progressbar" aria-valuenow={sk.value} aria-valuemin={0} aria-valuemax={100} aria-label={sk.label}>
                <div class="h-full rounded-full bg-rose" style={`width: ${sk.value}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <a href="#home" class="mt-9 inline-block rounded-full bg-rose px-7 py-3 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Learn More</a>
      </div>

      <div class="relative mx-auto w-full max-w-[420px]">
        <div class="arch relative overflow-hidden bg-blush shadow-xl shadow-rose/20">
          <img src="/images/expertise.jpg" alt="Woman in pink sweater holding a notebook" width="900" height="1350" class="aspect-[3/4] w-full object-cover object-top" loading="lazy" />
        </div>
        <Branch class="absolute -left-10 bottom-2 hidden h-56 w-auto sm:block lg:-left-16" />
        <div class="absolute -right-2 top-1/2 flex -translate-y-1/2 flex-col gap-3 lg:-right-6" aria-hidden="true">
          <span class="h-4 w-4 rounded-full bg-blush-soft"></span>
          <span class="h-4 w-4 rounded-full bg-blush"></span>
          <span class="h-4 w-4 rounded-full bg-wine"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="bg-wine py-10 text-white/85">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-5 px-5 sm:flex-row lg:px-8">
      <a href="#home" class="flex items-center gap-1.5">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2z" fill="#e78f8f"/></svg>
        <span class="font-display text-2xl font-bold italic text-white">Femine</span>
      </a>
      <nav class="flex gap-7 text-sm" aria-label="Footer navigation">
        <a href="#home" class="hover:text-white">Home</a>
        <a href="#about" class="hover:text-white">About Us</a>
        <a href="#services" class="hover:text-white">Services</a>
        <a href="#expertise" class="hover:text-white">Contact Us</a>
      </nav>
      <p class="text-[13px] text-white/60">© 2026 Femine. All rights reserved.</p>
    </div>
  </footer>
</Layout>
