---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import PaymentIcons from '../components/PaymentIcons.astro';
import { plans } from '../data/services';

const included = [
  { title: '60-minute 1-to-1 sessions', text: 'Just you and your coach, over video call, at a time that suits you.' },
  { title: 'A personal action plan', text: 'After every session you leave with one clear thing to practise — never vague homework.' },
  { title: 'Free rescheduling', text: 'Life happens. Reschedule any session free of charge up to 12 hours before it starts.' },
  { title: 'No subscription', text: 'You pay per plan, not per month. When your sessions are done, nothing renews itself.' },
];
const planSlug = (name: string) => (name === 'Single Session' ? 'single' : name === 'Growth Pack' ? 'growth' : 'transform');
const gifts = [
  { amount: '₹1,999', text: 'One 60-minute session — a thoughtful nudge for someone you care about.' },
  { amount: '₹3,999', text: 'Two sessions — enough to start a real change.' },
  { amount: '₹6,999', text: 'The full Growth Pack — four sessions, a complete fresh start.' },
];
const giftSlug = (amount: string) => 'gift-' + amount.replace(/[₹,]/g, '');
const pricingLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      itemListElement: plans.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Offer',
          name: p.name,
          price: Number(p.price.replace(/[^0-9]/g, '')),
          priceCurrency: 'INR',
          availability: 'https://schema.org/InStock',
          url: 'https://femine.pages.dev/pricing/',
          itemOffered: {
            '@type': 'Service',
            name: 'Femine personality coaching',
            provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev', telephone: '+91 98765 43210', image: 'https://femine.pages.dev/og.png' },
          },
        },
      })),
    },
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/pricing/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
  ],
};
---
<Layout title="Pricing — Femine" description="Simple, honest pricing: a single session at ₹1,999, a 4-session Growth Pack at ₹6,999, or an 8-session Transform Pack at ₹12,999. Your first 30-minute call is always free." jsonLd={pricingLd} ogImage="https://femine.pages.dev/og-pricing.png">
  <Header />
  <main id="main">
    <PageHero eyebrow="Pricing" title="Simple, honest pricing" text="Your first 30-minute call is always free. After that, you pay per plan — never per month, and there is no subscription." crumb="Pricing" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <p class="lead-answer mx-auto max-w-3xl text-center text-lg font-medium leading-relaxed text-ink">Femine coaching costs ₹1,999 for a single 60-minute session, ₹6,999 for 4 sessions, or ₹12,999 for 8 sessions. Your first 30-minute call is always free, you pay per plan — never per month — and unused sessions in a pack are refundable within 30 days.</p>
        <div class="mt-12 grid gap-6 md:grid-cols-3" data-reveal-group>
          {plans.map((p) => (
            <article class={`relative flex flex-col rounded-[2rem] px-7 py-9 ${p.featured ? 'bg-wine text-white shadow-xl shadow-wine/25 md:-translate-y-3' : 'bg-cream shadow-sm'}`}>
              {p.featured && (
                <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-rose-btn px-4 py-1.5 text-[13px] font-semibold text-white shadow">Most popular</span>
              )}
              <h2 class={`font-display text-2xl font-semibold ${p.featured ? 'text-white' : 'text-ink'}`}>{p.name}</h2>
              <p class={`mt-3 font-display text-4xl font-bold ${p.featured ? 'text-white' : 'text-ink'}`}>{p.price}</p>
              <p class={`mt-1 text-sm ${p.featured ? 'text-white/75' : 'text-muted'}`}>{p.per}</p>
              <ul class="mt-6 flex-1 space-y-3 text-[15px] leading-relaxed">
                {p.features.map((f) => (
                  <li class="flex gap-2.5">
                    <svg class={`mt-0.5 h-5 w-5 shrink-0 ${p.featured ? 'text-rose' : 'text-wine'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5"/></svg>
                    <span class={p.featured ? 'text-white/90' : 'text-muted'}>{f}</span>
                  </li>
                ))}
              </ul>
              <a href={`/book?plan=${planSlug(p.name)}`} class={`mt-8 inline-flex min-h-12 items-center justify-center rounded-full text-[15px] font-medium transition ${p.featured ? 'bg-white text-wine shadow-lg hover:bg-cream' : 'bg-rose-btn text-white shadow-md shadow-rose/30 hover:bg-rose-deep'}`}>Book a free call →</a>
            </article>
          ))}
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-reveal>
          <span class="text-sm font-medium text-muted">Pay securely with</span>
          <PaymentIcons />
          <span class="text-sm text-muted">· No card is stored on this site.</span>
        </div>

        <div class="mt-16" data-reveal>
          <h2 class="text-center font-display text-2xl font-semibold text-ink sm:text-3xl">Gift a session</h2>
          <p class="mx-auto mt-3 max-w-lg text-center text-base text-muted">Know someone who could use a little confidence? Gift them coaching — we send a beautiful gift card by email, valid for 12 months.</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-3">
            {gifts.map((g) => (
              <div class="rounded-[2rem] border-2 border-dashed border-rose/40 bg-cream px-6 py-7 text-center">
                <p class="font-display text-3xl font-bold text-wine">{g.amount}</p>
                <p class="mt-2 text-sm leading-relaxed text-muted">{g.text}</p>
                <a href={`/book?plan=${giftSlug(g.amount)}`} class="mt-5 inline-flex min-h-11 items-center rounded-full bg-rose-btn px-6 text-sm font-medium text-white transition hover:bg-rose-deep">Gift {g.amount} →</a>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-16" data-reveal>
          <h2 class="text-center font-display text-2xl font-semibold text-ink sm:text-3xl">Included in every plan</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {included.map((i) => (
              <div class="rounded-[2rem] bg-cream px-6 py-7">
                <h3 class="font-display text-lg font-semibold text-ink">{i.title}</h3>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{i.text}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-16 grid gap-6 lg:grid-cols-2" data-reveal-group>
          <div class="rounded-[2rem] bg-cream px-7 py-8">
            <h2 class="font-display text-2xl font-semibold text-ink">How payment works</h2>
            <ol class="mt-5 list-decimal space-y-3 pl-5 text-[15px] leading-relaxed text-muted">
              <li><strong class="font-semibold text-ink">Book a free call.</strong> We talk for 30 minutes and agree on the right plan together.</li>
              <li><strong class="font-semibold text-ink">We send a secure payment link.</strong> Pay by UPI, card or net banking — no account, no card stored on this site.</li>
              <li><strong class="font-semibold text-ink">We schedule your sessions.</strong> Weekly, at times that suit you, Monday to Saturday.</li>
            </ol>
            <p class="mt-5 text-[15px] leading-relaxed text-muted">Not sure which plan fits? Most clients notice a real change in 4 sessions and deeper change in 8 — and a single session is enough for one specific decision. We will help you choose on the free call.</p>
          </div>
          <div class="rounded-[2rem] bg-wine px-7 py-8 text-white">
            <h2 class="font-display text-2xl font-semibold">Our promise</h2>
            <p class="mt-4 text-[15px] leading-relaxed text-white/85">If a plan is not working for you, you are not locked in. Unused sessions in a pack can be refunded within 30 days of purchase, and a single session is refundable up to 12 hours before it starts.</p>
            <p class="mt-4"><a href="/refund-policy" class="font-medium text-white underline underline-offset-4 hover:text-rose">Read the full refund policy →</a></p>
            <p class="mt-6"><a href="/faq" class="font-medium text-white underline underline-offset-4 hover:text-rose">Questions about pricing? See the FAQ →</a></p>
          </div>
        </div>

        <div class="mt-16" data-reveal>
          <h2 class="text-center font-display text-2xl font-semibold text-ink sm:text-3xl">Which plan should you choose?</h2>
          <p class="mx-auto mt-3 max-w-2xl text-center text-base leading-relaxed text-muted">The honest answer: it depends on what you are trying to change. Here is how most clients decide — and if you are still unsure, the free call exists for exactly this question.</p>
          <div class="mt-10 grid gap-5 md:grid-cols-3">
            <div class="rounded-[2rem] bg-cream px-6 py-8">
              <h3 class="font-display text-xl font-semibold text-ink">Single Session — for one decision</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">You have one specific thing: a difficult conversation next week, a decision you keep postponing, a meeting you need to speak up in. One focused hour, a clear plan, and you are done. No commitment beyond that.</p>
            </div>
            <div class="rounded-[2rem] bg-cream px-6 py-8">
              <h3 class="font-display text-xl font-semibold text-ink">Growth Pack — for a real change</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">Four sessions over a month is where most clients first feel the difference — the meeting where they spoke first, the no that came out easily. This is the plan most people choose, and the one we usually recommend starting with.</p>
            </div>
            <div class="rounded-[2rem] bg-cream px-6 py-8">
              <h3 class="font-display text-xl font-semibold text-ink">Transform Pack — for a new chapter</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-muted">Eight sessions over two months, for a bigger shift: a career change, a new role, rebuilding confidence from the ground up. You get a full plan, all the worksheets, and priority booking.</p>
            </div>
          </div>
        </div>

        <div class="mt-16" data-reveal>
          <h2 class="text-center font-display text-2xl font-semibold text-ink sm:text-3xl">Pricing questions, answered</h2>
          <div class="mx-auto mt-10 grid max-w-4xl gap-5 md:grid-cols-2">
            <div class="rounded-[2rem] bg-cream px-6 py-7">
              <h3 class="font-display text-lg font-semibold text-ink">Is the first call really free?</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">Yes — 30 minutes, no card, no obligation. If we are not the right fit, you still keep whatever we discussed on the call.</p>
            </div>
            <div class="rounded-[2rem] bg-cream px-6 py-7">
              <h3 class="font-display text-lg font-semibold text-ink">Do sessions expire?</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">Packs do not have a hard expiry — we schedule weekly, and if life interrupts, we pause. Unused sessions in a pack are refundable within 30 days of purchase.</p>
            </div>
            <div class="rounded-[2rem] bg-cream px-6 py-7">
              <h3 class="font-display text-lg font-semibold text-ink">Can I upgrade later?</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">Yes. Start with a single session or the Growth Pack and upgrade to Transform later — you only pay the difference, never twice for the same session.</p>
            </div>
            <div class="rounded-[2rem] bg-cream px-6 py-7">
              <h3 class="font-display text-lg font-semibold text-ink">What if I need to reschedule?</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">Reschedule free up to 12 hours before your session. Just send us a message and we will find a new time — no fee, no fuss.</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
