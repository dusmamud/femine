---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const slug = (id: string) => id.replace(/\.md$/, '');
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const hubItems = [
  ...posts.map((p) => ({ name: p.data.title, url: `https://femine.pages.dev/blog/${slug(p.id)}/` })),
  { name: 'The Confidence First-Aid Kit — free guide', url: 'https://femine.pages.dev/free-guide/' },
  { name: 'A quick hello from Meera — your coach (video)', url: 'https://femine.pages.dev/about/' },
  { name: 'Client story — watch on Testimonials (video)', url: 'https://femine.pages.dev/testimonials/' },
  { name: 'Find your programme — quiz', url: 'https://femine.pages.dev/quiz/' },
  { name: '7-Day Confidence Challenge', url: 'https://femine.pages.dev/challenges/' },
];
const resourcesLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/resources/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
    {
      '@type': 'ItemList',
      name: 'Femine resources',
      itemListElement: hubItems.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item.name,
        url: item.url,
      })),
    },
  ],
};
---
<Layout title="Resources — Femine" description="Everything free from Femine in one place: practical articles, the free Confidence First-Aid Kit guide, videos and tools to build confidence." jsonLd={resourcesLd}>
  <Header />
  <main id="main">
    <PageHero eyebrow="Resources" title="Everything free, in one place" text="Articles, the free guide, videos and tools — all the practical help Femine gives away, collected here." crumb="Resources" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="max-w-3xl" data-reveal>
          <p class="lead-answer mt-4 text-lg font-medium leading-relaxed text-ink">Femine&rsquo;s free resources are the articles on the blog, the 8-page Confidence First-Aid Kit guide, two short videos, and two tools — a quiz to find your programme and a 7-day confidence challenge. Everything here is free, and nothing asks for a card.</p>
        </div>

        <!-- ============ ARTICLES ============ -->
        <div class="mt-14" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Articles</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">From the blog</h2>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {posts.map((p) => (
            <article class="flex flex-col overflow-hidden rounded-[2rem] bg-cream shadow-sm transition hover:shadow-lg">
              <a href={`/blog/${slug(p.id)}`} class="block" aria-label={p.data.title}>
                <Picture src={p.data.image} alt={p.data.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 768px) 100vw, 33vw" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="lazy" class="aspect-[16/10] w-full object-cover" />
              </a>
              <div class="flex flex-1 flex-col px-6 py-6">
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[13px] font-medium text-muted">
                  <span class="whitespace-nowrap rounded-full bg-white px-3 py-1 text-[12px] font-semibold text-wine">{p.data.category}</span>
                  <span class="whitespace-nowrap">{fmt(p.data.pubDate)}</span><span aria-hidden="true">·</span><span class="whitespace-nowrap">{p.data.readingMinutes} min read</span>
                </p>
                <h3 class="mt-3 font-display text-[20px] font-semibold leading-snug text-ink">
                  <a href={`/blog/${slug(p.id)}`} class="hover:text-wine">{p.data.title}</a>
                </h3>
                <p class="mt-2 flex-1 text-[15px] leading-relaxed text-muted">{p.data.excerpt}</p>
                <a href={`/blog/${slug(p.id)}`} class="mt-5 inline-flex min-h-11 w-fit items-center text-[15px] font-medium text-wine hover:underline">Read article →</a>
              </div>
            </article>
          ))}
        </div>

        <!-- ============ FREE GUIDE ============ -->
        <div class="mt-16" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Free Guide</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">The Confidence First-Aid Kit</h2>
        </div>
        <div class="mt-8 rounded-[2rem] bg-cream px-6 py-8 sm:px-10" data-reveal>
          <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
            <div class="max-w-xl">
              <h3 class="font-display text-[22px] font-semibold text-ink">Five practical tools, 8 pages, free</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">A 2-minute confidence reset, saying no without guilt, a decision filter, speaking up in meetings, and a 7-day confidence plan. Enter your name and email, and the PDF is yours.</p>
            </div>
            <a href="/free-guide" class="inline-flex min-h-12 shrink-0 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Get the free guide →</a>
          </div>
        </div>

        <!-- ============ VIDEOS ============ -->
        <div class="mt-16" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Videos</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Watch Femine</h2>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2" data-reveal-group>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Meet Your Coach</p>
            <h3 class="mt-3 font-display text-[22px] font-semibold text-ink">A quick hello from Meera</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Meet Meera Kapoor, founder and lead coach at Femine, in a short introduction video on the About page.</p>
            <a href="/about" class="mt-5 inline-flex min-h-11 items-center text-[15px] font-medium text-wine hover:underline">Watch on About →</a>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Client Story</p>
            <h3 class="mt-3 font-display text-[22px] font-semibold text-ink">A client&rsquo;s story, in her own words</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">A short video from one of our clients about what changed for her — watch it on the Testimonials page.</p>
            <a href="/testimonials" class="mt-5 inline-flex min-h-11 items-center text-[15px] font-medium text-wine hover:underline">Watch on Testimonials →</a>
          </article>
        </div>

        <!-- ============ TOOLS ============ -->
        <div class="mt-16" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Tools</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Try something small today</h2>
        </div>
        <div class="mt-8 grid gap-5 md:grid-cols-2" data-reveal-group>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <h3 class="font-display text-[22px] font-semibold text-ink">Find your programme</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Not sure where to start? A short quiz points you to the coaching programme that fits what you want to change.</p>
            <a href="/quiz" class="mt-5 inline-flex min-h-12 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Take the quiz →</a>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <h3 class="font-display text-[22px] font-semibold text-ink">7-Day Confidence Challenge</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">One small brave thing a day for seven days — one short email a day to keep you going. Free, no card needed.</p>
            <a href="/challenges" class="mt-5 inline-flex min-h-12 items-center rounded-full bg-rose-btn px-8 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Start the challenge →</a>
          </article>
        </div>

        <div class="mt-16 rounded-[2rem] bg-wine px-6 py-10 text-center text-white sm:px-10" data-reveal>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">Want help applying any of this?</h2>
          <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-white/80">Reading helps. Practising with a coach helps faster. Your first 30-minute session is free.</p>
          <a href="/book" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-white px-8 text-[15px] font-medium text-wine shadow-lg transition hover:bg-cream">Book your free session →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
