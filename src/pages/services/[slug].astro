---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/services';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service: s } = Astro.props;
const others = services.filter((x) => x.slug !== s.slug);
const priceNum = Number(s.priceFrom.replace(/[^0-9]/g, ''));
const serviceLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${s.title} Coaching`,
      description: s.long,
      provider: {
        '@type': 'ProfessionalService',
        name: 'Femine',
        url: 'https://femine.pages.dev',
        telephone: '+91 98765 43210',
        email: 'hello@femine.in',
        image: 'https://femine.pages.dev/og.png',
      },
      areaServed: 'India',
      serviceType: s.title,
      offers: {
        '@type': 'Offer',
        price: priceNum,
        priceCurrency: 'INR',
        availability: 'https://schema.org/InStock',
        url: new URL(Astro.url.pathname, Astro.site).href,
      },
    },
    {
      '@type': 'WebPage',
      '@id': new URL(Astro.url.pathname, Astro.site).href,
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
  ],
};
---
<Layout title={`${s.title} Coaching — Femine`} description={s.short} jsonLd={serviceLd} ogImage={new URL(s.image.src, Astro.site).href} ogImageWidth={s.image.width} ogImageHeight={s.image.height}>
  <Header />
  <main id="main">
    <PageHero eyebrow="Service" title={s.title} text={s.short} crumb={s.title} />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 lg:grid-cols-[1.5fr_1fr] lg:gap-16 lg:px-8">
        <div data-reveal>
          <div class="overflow-hidden rounded-[2rem] shadow-lg shadow-rose/10">
            <Picture src={s.image} alt={s.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 1023px) calc(100vw - 40px), 614px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={72} loading="eager" fetchpriority="high" class="aspect-[16/9] w-full object-cover" />
          </div>
          <h2 class="fluid-h2 mt-8 font-display font-semibold text-ink">What this programme covers</h2>
          <p class="lead-answer mt-5 text-lg font-medium leading-relaxed text-ink">{s.lead}</p>
          <p class="mt-5 text-base leading-relaxed text-muted">{s.long}</p>
          <ul class="mt-8 space-y-3.5">
            {s.benefits.map((b) => (
              <li class="flex gap-3 rounded-2xl bg-cream px-5 py-4 text-[15px] leading-relaxed text-ink">
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-rose-btn text-[13px] font-bold text-white" aria-hidden="true">✓</span>{b}
              </li>
            ))}
          </ul>
          <h3 class="mt-10 font-display text-2xl font-semibold text-ink">What you will walk away with</h3>
          <ul class="mt-5 flex flex-wrap gap-2.5">
            {s.outcomes.map((o) => (
              <li class="rounded-full border border-rose/30 bg-white px-4 py-2 text-sm font-medium text-wine">{o}</li>
            ))}
          </ul>
        </div>

        <aside data-reveal>
          <div class="rounded-[2rem] bg-cream px-7 py-8 lg:sticky lg:top-24">
            <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Session details</p>
            <dl class="mt-5 space-y-4 text-[15px]">
              <div class="flex justify-between gap-4"><dt class="text-muted">Duration</dt><dd class="font-medium text-ink">{s.duration}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-muted">Format</dt><dd class="font-medium text-ink">{s.format}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-muted">Price</dt><dd class="font-medium text-ink">From {s.priceFrom}</dd></div>
              <div class="flex justify-between gap-4"><dt class="text-muted">First call</dt><dd class="font-medium text-ink">30 min · Free</dd></div>
            </dl>
            <a href="/book" class="mt-7 flex min-h-12 items-center justify-center rounded-full bg-rose-btn px-6 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Book a free call →</a>
            <p class="mt-4 text-center text-[13px] text-muted">Reschedule free up to 12 hours before.</p>
          </div>
        </aside>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20" aria-label="Other programmes">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <h2 class="text-center font-display text-[28px] font-semibold text-ink sm:text-[32px]" data-reveal>Explore other programmes</h2>
        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
          {others.map((o) => (
            <a href={`/services/${o.slug}`} class="group rounded-[2rem] bg-white px-6 py-7 shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
              <h3 class="font-display text-xl font-semibold text-ink group-hover:text-wine">{o.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{o.short}</p>
              <span class="mt-4 inline-block text-sm font-medium text-wine">Learn more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
