---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { services, plans } from '../../data/services';
---
<Layout title="Services — Femine" description="Four focused coaching programmes: Problem Solving, Relationships, Identifying Passion and Growth Career. 1-to-1 online sessions from ₹1,999.">
  <Header />
  <main id="main">
    <PageHero eyebrow="Our Services" title="Four programmes, one goal: a stronger you" text="Every programme is 1-to-1, online, and built around your real life — not a generic course. Pick one, or combine them." crumb="Services" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2" data-reveal-group>
          {services.map((s) => (
            <article class="flex flex-col overflow-hidden rounded-[2rem] bg-cream shadow-sm">
              <div class="relative">
                <Picture src={s.image} alt={s.imageAlt} widths={[480, 960]} sizes="(max-width: 768px) 100vw, 50vw" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="lazy" class="aspect-[16/10] w-full object-cover" />
                <span class="absolute bottom-3 right-3 rounded-full bg-white px-3 py-1.5 text-[13px] font-semibold text-wine shadow">{s.priceFrom} / session</span>
              </div>
              <div class="flex flex-1 flex-col px-7 py-8">
              <div class="flex items-start gap-4">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-white text-wine shadow-sm">
                  {s.icon === 'bulb' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.2 1.1 2.2h5c0-1 .4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg>}
                  {s.icon === 'heart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.3-9.3-9A5.2 5.2 0 0 1 12 6.5 5.2 5.2 0 0 1 21.3 11C19 15.7 12 20 12 20z"/><path d="M12 6.5L14 9l2.5.5"/></svg>}
                  {s.icon === 'target' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>}
                  {s.icon === 'chart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18M7 16v-5M12 16V8M17 16v-3"/></svg>}
                </span>
              </div>
              <h2 class="mt-5 font-display text-2xl font-semibold text-ink">{s.title}</h2>
              <p class="mt-2.5 flex-1 text-[15px] leading-relaxed text-muted">{s.long}</p>
              <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px] font-medium text-ink/70">
                <span>{s.duration}</span><span>·</span><span>{s.format}</span>
              </div>
              <a href={`/services/${s.slug}`} class="mt-6 inline-flex min-h-12 w-fit items-center rounded-full bg-rose px-6 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Explore {s.title} →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="Pricing">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="text-center" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Pricing</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Simple, honest pricing</h2>
          <p class="mx-auto mt-3 max-w-lg text-base text-muted">No hidden charges, no lock-in. Your first 30-minute call is always free.</p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
          {plans.map((p) => (
            <article class={`relative rounded-[2rem] px-7 py-9 text-center ${p.featured ? 'bg-rose text-white shadow-xl shadow-rose/30' : 'bg-white text-ink shadow-sm'}`}>
              {p.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-wine px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white">Most popular</span>}
              <h3 class="font-display text-xl font-semibold">{p.name}</h3>
              <p class="mt-3 font-display text-4xl font-bold">{p.price}</p>
              <p class={`mt-1 text-sm ${p.featured ? 'text-white/80' : 'text-muted'}`}>{p.per}</p>
              <ul class={`mt-6 space-y-2.5 text-left text-sm ${p.featured ? 'text-white/90' : 'text-muted'}`}>
                {p.features.map((f) => (
                  <li class="flex gap-2.5"><span aria-hidden="true" class={p.featured ? 'text-white' : 'text-rose-deep'}>✓</span>{f}</li>
                ))}
              </ul>
              <a href="/book" class={`mt-7 inline-flex min-h-12 items-center justify-center rounded-full px-7 text-[15px] font-medium ${p.featured ? 'bg-white text-wine' : 'bg-rose text-white hover:bg-rose-deep'}`}>Book now</a>
            </article>
          ))}
        </div>
        <p class="mt-10 text-center" data-reveal>
          <a href="/pricing" class="text-[15px] font-medium text-wine hover:underline">See full pricing details, what's included and how payment works →</a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
