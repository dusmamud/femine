---
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import { services, plans } from '../../data/services';

const servicesLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ItemList',
      itemListElement: services.map((s, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: `${s.title} Coaching`,
          description: s.long,
          url: `https://femine.pages.dev/services/${s.slug}/`,
          provider: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' },
          offers: {
            '@type': 'Offer',
            price: Number(s.priceFrom.replace(/[^0-9]/g, '')),
            priceCurrency: 'INR',
            availability: 'https://schema.org/InStock',
          },
        },
      })),
    },
    {
      '@type': 'WebPage',
      '@id': 'https://femine.pages.dev/services/',
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead-answer'] },
    },
  ],
};
---
<Layout title="Services — Femine" description="Five focused coaching programmes: Problem Solving, Relationships, Identifying Passion, Growth Career and Corporate Workshops. 1-to-1 online sessions from ₹1,999." jsonLd={servicesLd} ogImage="https://femine.pages.dev/og-services.png">
  <Header />
  <main id="main">
    <PageHero eyebrow="Our Services" title="Five programmes, one goal: a stronger you" text="Every programme is 1-to-1, online, and built around your real life — not a generic course. Pick one, or combine them." crumb="Services" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2" data-reveal-group>
          {services.map((s) => (
            <article class="flex flex-col overflow-hidden rounded-[2rem] bg-cream shadow-sm">
              <div class="relative">
                <Picture src={s.image} alt={s.imageAlt} widths={[480, 960]} sizes="(max-width: 768px) 100vw, 50vw" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="lazy" class="aspect-[16/10] w-full object-cover" />
                <span class="absolute bottom-3 right-3 rounded-full bg-white px-3 py-1.5 text-[13px] font-semibold text-wine shadow">{s.priceFrom} / session</span>
              </div>
              <div class="flex flex-1 flex-col px-7 py-8">
              <div class="flex items-start gap-4">
                <span class="grid h-14 w-14 place-items-center rounded-full bg-white text-wine shadow-sm">
                  {s.icon === 'bulb' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.2 1.1 2.2h5c0-1 .4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg>}
                  {s.icon === 'heart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.3-9.3-9A5.2 5.2 0 0 1 12 6.5 5.2 5.2 0 0 1 21.3 11C19 15.7 12 20 12 20z"/><path d="M12 6.5L14 9l2.5.5"/></svg>}
                  {s.icon === 'target' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/></svg>}
                  {s.icon === 'chart' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18M7 16v-5M12 16V8M17 16v-3"/></svg>}
                  {s.icon === 'users' && <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
                </span>
              </div>
              <h2 class="mt-5 font-display text-2xl font-semibold text-ink">{s.title}</h2>
              <p class="mt-2.5 flex-1 text-[15px] leading-relaxed text-muted">{s.long}</p>
              <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px] font-medium text-ink/70">
                <span>{s.duration}</span><span>·</span><span>{s.format}</span>
              </div>
              <a href={`/services/${s.slug}`} class="mt-6 inline-flex min-h-12 w-fit items-center rounded-full bg-rose px-6 text-[15px] font-medium text-white shadow-md shadow-rose/30 transition hover:bg-rose-deep">Explore {s.title} →</a>
              </div>
            </article>
          ))}
          <article class="flex flex-col justify-center rounded-[2rem] bg-wine px-7 py-8 text-white shadow-sm">
            <h2 class="font-display text-2xl font-semibold">Not sure where to start?</h2>
            <p class="mt-2.5 text-[15px] leading-relaxed text-white/85">Book a free 30-minute call — we'll help you pick the programme that fits your goals, together.</p>
            <a href="/book" class="mt-6 inline-flex min-h-12 w-fit items-center rounded-full bg-white px-6 text-[15px] font-medium text-wine shadow-md transition hover:bg-cream">Book a free call →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20 lg:py-24" aria-label="How to choose">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="max-w-3xl" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Not Sure Which One?</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">How to choose the right programme</h2>
          <p class="lead-answer mt-5 text-lg font-medium leading-relaxed text-ink">Femine has five coaching programmes, all 1-to-1 and online, from ₹1,999 per 60-minute session. Pick the one that matches the problem you feel most — and if two fit, start with either, because every plan lets you mix programmes later.</p>
          <p class="mt-4 text-base leading-relaxed text-muted">The simplest way to choose is to finish this sentence: “The thing I most want to change is…” Then match it below. And if you still cannot decide, that is exactly what the free 30-minute call is for — we help you pick, with no obligation to book anything after.</p>
        </div>
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-sm font-semibold text-wine">If you keep postponing decisions…</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink"><a href="/services/problem-solving" class="hover:text-wine">Problem Solving →</a></h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">You replay every option at 2am, ask ten people for advice, and still feel no closer. This programme gives you a 4-step framework to break a problem down and decide without the spiral.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-sm font-semibold text-wine">If you say yes when you mean no…</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink"><a href="/services/relationships" class="hover:text-wine">Relationships →</a></h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Difficult conversations turn into fights or silence, and boundaries feel impossible. This programme teaches you to say what you mean kindly — and to mean it.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-sm font-semibold text-wine">If you have no idea what comes next…</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink"><a href="/services/identifying-passion" class="hover:text-wine">Identifying Passion →</a></h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Good at your job, unsure it is the right job. This programme maps your strengths, interests and values, then tests a direction with small experiments before any big change.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-sm font-semibold text-wine">If your work is invisible…</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink"><a href="/services/growth-career" class="hover:text-wine">Growth Career →</a></h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">You do good work and nobody notices. This programme builds visibility, speaking up in meetings, and negotiating for the role and salary you deserve.</p>
          </article>
          <article class="rounded-[2rem] bg-cream px-6 py-8">
            <p class="text-sm font-semibold text-wine">If your whole team needs it…</p>
            <h3 class="mt-2 font-display text-xl font-semibold text-ink"><a href="/services/corporate-workshops" class="hover:text-wine">Corporate Workshops →</a></h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">One confident person changes a team. Half-day workshops on communication, feedback and leadership presence, designed around your team's real challenges.</p>
          </article>
          <article class="flex flex-col justify-center rounded-[2rem] bg-wine px-6 py-8 text-white">
            <h3 class="font-display text-xl font-semibold">Still torn between two?</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-white/85">Book a free call. In 30 minutes we will help you pick — and if we are not the right fit, we will say so.</p>
            <a href="/book" class="mt-5 inline-flex min-h-11 w-fit items-center rounded-full bg-white px-6 text-sm font-medium text-wine">Book a free call →</a>
          </article>
        </div>
        <div class="mt-14 grid gap-6 lg:grid-cols-3" data-reveal-group>
          <div class="rounded-[2rem] bg-cream px-6 py-7">
            <h3 class="font-display text-lg font-semibold text-ink">How sessions work</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Every programme runs the same way: 60-minute 1-to-1 sessions over video call, Monday to Saturday, 10am–7pm IST. You bring a real situation; we work on it together; you leave with one small thing to practise that week.</p>
          </div>
          <div class="rounded-[2rem] bg-cream px-6 py-7">
            <h3 class="font-display text-lg font-semibold text-ink">How many sessions?</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">A single session is enough for one specific decision or conversation. Most clients notice a real change in 4 sessions and deeper change in 8. After your free call, we agree on a plan together — never more than you need.</p>
          </div>
          <div class="rounded-[2rem] bg-cream px-6 py-7">
            <h3 class="font-display text-lg font-semibold text-ink">Can you mix programmes?</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Yes. Your plan is not locked to one programme. Many clients start with Relationships and move to Growth Career, or the other way round. We adjust the plan together as your goals change.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-cream py-16 sm:py-20 lg:py-24" aria-label="Pricing">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="text-center" data-reveal>
          <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Pricing</p>
          <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Simple, honest pricing</h2>
          <p class="mx-auto mt-3 max-w-lg text-base text-muted">No hidden charges, no lock-in. Your first 30-minute call is always free.</p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-3" data-reveal-group>
          {plans.map((p) => (
            <article class={`relative rounded-[2rem] px-7 py-9 text-center ${p.featured ? 'bg-rose text-white shadow-xl shadow-rose/30' : 'bg-white text-ink shadow-sm'}`}>
              {p.featured && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-wine px-3 py-1 text-[11px] font-semibold uppercase tracking-wider text-white">Most popular</span>}
              <h3 class="font-display text-xl font-semibold">{p.name}</h3>
              <p class="mt-3 font-display text-4xl font-bold">{p.price}</p>
              <p class={`mt-1 text-sm ${p.featured ? 'text-white/80' : 'text-muted'}`}>{p.per}</p>
              <ul class={`mt-6 space-y-2.5 text-left text-sm ${p.featured ? 'text-white/90' : 'text-muted'}`}>
                {p.features.map((f) => (
                  <li class="flex gap-2.5"><span aria-hidden="true" class={p.featured ? 'text-white' : 'text-rose-deep'}>✓</span>{f}</li>
                ))}
              </ul>
              <a href="/book" class={`mt-7 inline-flex min-h-12 items-center justify-center rounded-full px-7 text-[15px] font-medium ${p.featured ? 'bg-white text-wine' : 'bg-rose text-white hover:bg-rose-deep'}`}>Book now</a>
            </article>
          ))}
        </div>
        <p class="mt-10 text-center" data-reveal>
          <a href="/pricing" class="text-[15px] font-medium text-wine hover:underline">See full pricing details, what's included and how payment works →</a>
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
