---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { testimonials } from '../data/testimonials';
---
<Layout title="Client Stories — Femine" description="Real stories from Femine clients: confidence at work, calmer relationships, and careers with direction.">
  <Header />
  <main id="main">
    <PageHero eyebrow="Client Stories" title="What changes, in their words" text="Every story below is from a real client, shared with permission. Names are real; some details are shortened for privacy." crumb="Testimonials" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="mx-auto grid max-w-3xl grid-cols-3 gap-4 text-center" data-reveal>
          <div><p class="font-display text-3xl font-bold text-wine sm:text-4xl">4.9<span class="text-xl">/5</span></p><p class="mt-1 text-[13px] text-muted">Average client rating</p></div>
          <div><p class="font-display text-3xl font-bold text-wine sm:text-4xl">500+</p><p class="mt-1 text-[13px] text-muted">Sessions completed</p></div>
          <div><p class="font-display text-3xl font-bold text-wine sm:text-4xl">92%</p><p class="mt-1 text-[13px] text-muted">Would recommend us</p></div>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {testimonials.map((t) => (
            <figure class="flex flex-col rounded-[2rem] bg-cream px-6 py-8 shadow-sm">
              <span class="flex gap-0.5 text-rose-deep" role="img" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
                ))}
              </span>
              <blockquote class="mt-4 flex-1 font-display text-[19px] leading-snug text-ink">“{t.quote}”</blockquote>
              <figcaption class="mt-5 flex items-center gap-3">
                <Image src={t.img} alt={`Portrait of ${t.name}`} widths={[96]} sizes="44px" format="avif" quality={80} loading="lazy" class="h-11 w-11 rounded-full object-cover ring-2 ring-white" />
                <span>
                  <span class="block text-sm font-semibold text-ink">{t.name}</span>
                  <span class="block text-[13px] text-muted">{t.role}</span>
                </span>
              </figcaption>
              <p class="mt-4"><a href={`/services/${t.programme.toLowerCase().replace(/ /g, '-')}`} class="inline-block rounded-full bg-white px-3 py-1.5 text-[12px] font-semibold text-wine hover:bg-blush-soft">{t.programme}</a></p>
            </figure>
          ))}
        </div>

        <div class="mt-16 rounded-[2rem] bg-wine px-6 py-10 text-center text-white sm:px-10" data-reveal>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">Your story could be next</h2>
          <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-white/80">Start with a free 30-minute call. No commitment, no pressure — just an honest conversation about where you want to go.</p>
          <a href="/contact" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-white px-8 text-[15px] font-medium text-wine shadow-lg transition hover:bg-cream">Book your free session →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
