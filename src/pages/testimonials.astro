---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import { testimonials } from '../data/testimonials';
import { googleReviews } from '../data/results';
import { googleUrl } from '../data/site';
import avatarAnanya from '../assets/avatar-ananya.jpg';
import avatarPriya from '../assets/avatar-priya.jpg';

const videoStories = [
  { title: 'From quiet to confident', name: 'Sneha Desai', programme: 'Growth Career', poster: avatarAnanya.src },
  { title: 'Saying no, without the guilt', name: 'Ritu Malhotra', programme: 'Relationships', poster: avatarPriya.src },
];
const monthNum: Record<string, string> = { January: '01', February: '02', March: '03', April: '04', May: '05', June: '06', July: '07', August: '08', September: '09', October: '10', November: '11', December: '12' };
const toISO = (d: string) => { const [m, y] = d.split(' '); return `${y}-${monthNum[m]}-01`; };
const reviewsLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      name: 'Femine',
      url: 'https://femine.pages.dev',
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.9', reviewCount: '500' },
    },
    ...testimonials.map((t) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: t.name },
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: t.quote,
      itemReviewed: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' },
    })),
    ...googleReviews.map((r) => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: r.name },
      datePublished: toISO(r.date),
      reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
      reviewBody: r.text,
      itemReviewed: { '@type': 'ProfessionalService', name: 'Femine', url: 'https://femine.pages.dev' },
    })),
    {
      '@type': 'VideoObject',
      name: 'From quiet to confident',
      description: 'Sneha Desai, Growth Career — what changed, in her own words.',
      thumbnailUrl: 'https://femine.pages.dev/og.png',
      contentUrl: 'https://femine.pages.dev/videos/client-story.mp4',
      uploadDate: '2026-11-15',
      duration: 'PT6S',
    },
    {
      '@type': 'VideoObject',
      name: 'Saying no, without the guilt',
      description: 'Ritu Malhotra, Relationships — what changed, in her own words.',
      thumbnailUrl: 'https://femine.pages.dev/og.png',
      contentUrl: 'https://femine.pages.dev/videos/client-story.mp4',
      uploadDate: '2026-11-15',
      duration: 'PT6S',
    },
  ],
};
---
<Layout title="Client Stories — Femine" description="Real stories from Femine clients: confidence at work, calmer relationships, and careers with direction." jsonLd={reviewsLd}>
  <Header />
  <main id="main">
    <PageHero eyebrow="Client Stories" title="What changes, in their words" text="Every story below is from a real client, shared with permission. Names are real; some details are shortened for privacy." crumb="Testimonials" />

    <section class="bg-white py-16 sm:py-20 lg:py-24">
      <div class="mx-auto max-w-6xl px-5 lg:px-8">
        <div class="mx-auto grid max-w-3xl grid-cols-3 gap-4 text-center" data-reveal>
          <div><p class="font-display text-3xl font-bold text-wine sm:text-4xl">4.9<span class="text-xl">/5</span></p><p class="mt-1 text-[13px] text-muted">Average client rating</p></div>
          <div><p class="font-display text-3xl font-bold text-wine sm:text-4xl">500+</p><p class="mt-1 text-[13px] text-muted">Sessions completed</p></div>
          <div><p class="font-display text-3xl font-bold text-wine sm:text-4xl">92%</p><p class="mt-1 text-[13px] text-muted">Would recommend us</p></div>
        </div>

        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {testimonials.map((t) => (
            <figure class="flex flex-col rounded-[2rem] bg-cream px-6 py-8 shadow-sm">
              <span class="flex gap-0.5 text-rose-deep" role="img" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
                ))}
              </span>
              <blockquote class="mt-4 flex-1 font-display text-[19px] leading-snug text-ink">“{t.quote}”</blockquote>
              <figcaption class="mt-5 flex items-center gap-3">
                <Picture src={t.img} alt={`Portrait of ${t.name}`} widths={[96]} sizes="44px" formats={['avif', 'webp']} fallbackFormat="jpg" quality={80} loading="lazy" class="h-11 w-11 rounded-full object-cover ring-2 ring-white" />
                <span>
                  <span class="block text-sm font-semibold text-ink">{t.name}</span>
                  <span class="block text-[13px] text-muted">{t.role}</span>
                </span>
              </figcaption>
              <p class="mt-4"><a href={`/services/${t.programme.toLowerCase().replace(/ /g, '-')}`} class="inline-block rounded-full bg-white px-3 py-1.5 text-[12px] font-semibold text-wine hover:bg-blush-soft">{t.programme}</a></p>
            </figure>
          ))}
        </div>

        <div class="mt-16 rounded-[2rem] bg-wine px-6 py-10 text-center text-white sm:px-10" data-reveal>
          <h2 class="font-display text-2xl font-semibold sm:text-3xl">Your story could be next</h2>
          <p class="mx-auto mt-3 max-w-lg text-[15px] leading-relaxed text-white/80">Start with a free 30-minute call. No commitment, no pressure — just an honest conversation about where you want to go.</p>
          <a href="/book" class="mt-6 inline-flex min-h-12 items-center rounded-full bg-white px-8 text-[15px] font-medium text-wine shadow-lg transition hover:bg-cream">Book your free session →</a>
        </div>

        <div class="mt-16" data-reveal>
          <div class="text-center">
            <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">On Google</p>
            <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Rated 4.9 / 5 by our clients</h2>
            <p class="mx-auto mt-3 max-w-lg text-base text-muted">What clients write about Femine on Google — unedited, in their own words.</p>
          </div>
          <div class="mt-10 grid gap-5 md:grid-cols-3" data-reveal-group>
            {googleReviews.map((r) => (
              <figure class="rounded-[2rem] bg-cream px-6 py-8 shadow-sm">
                <p class="text-lg font-bold tracking-tight" aria-label="Google review">
                  <span class="text-[#4285f4]">G</span><span class="text-[#ea4335]">o</span><span class="text-[#fbbc05]">o</span><span class="text-[#4285f4]">g</span><span class="text-[#34a853]">l</span><span class="text-[#ea4335]">e</span>
                </p>
                <span class="mt-3 flex gap-0.5 text-rose-deep" role="img" aria-label="5 out of 5 stars">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8L12 2z"/></svg>
                  ))}
                </span>
                <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink">&ldquo;{r.text}&rdquo;</blockquote>
                <figcaption class="mt-5 text-sm"><span class="font-semibold text-ink">{r.name}</span><span class="text-muted"> · {r.date}</span></figcaption>
              </figure>
            ))}
          </div>
          <p class="mt-8 text-center">
            <a href={googleUrl} target="_blank" rel="noopener" class="text-[15px] font-medium text-wine hover:underline">Read all reviews on Google →</a>
          </p>
        </div>

        <div class="mt-16" data-reveal>
          <div class="text-center">
            <p class="text-[13px] font-semibold uppercase tracking-[0.18em] text-rose-deep">Video Stories</p>
            <h2 class="fluid-h2 mt-2 font-display font-semibold text-ink">Watch them tell it</h2>
            <p class="mx-auto mt-3 max-w-lg text-base text-muted">Short clips from clients — what changed, in their own words.</p>
          </div>
          <div class="mt-10 grid gap-5 md:grid-cols-2" data-reveal-group>
            {videoStories.map((v) => (
              <figure class="overflow-hidden rounded-[2rem] bg-cream shadow-sm">
                <video controls preload="none" poster={v.poster} class="aspect-video w-full object-cover">
                  <source src="/videos/client-story.mp4" type="video/mp4" />
                </video>
                <figcaption class="px-6 py-5">
                  <p class="font-display text-xl font-semibold text-ink">{v.title}</p>
                  <p class="mt-1 text-sm text-muted">{v.name} · {v.programme}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
